    Devices: "devices",
    Inventory: "inventory",
    Software: "software",
    "Remote Access": "remote",
    Monitoring: "monitoring",
    Ticketing: "ticketing",
    "Knowledge Base": "knowledge",
    "Tasks & Automation": "tasks",
    Services: "services",
    "Identity & Access": "identity",
    Policies: "policies",
    "Audit Logs": "audit",
    Settings: "settings"
};

function getModuleLabel(name) {
    const key = moduleTranslationKeys[name];
    const value = currentTranslations()?.[key];

    return typeof value === "string" ? value : name;
}

function setText(selector, value) {
    const element = $(selector);

    if (element && typeof value === "string") {
        element.textContent = value;
    }
}

/* =========================================================
   LANGUAGE APPLICATION
   ========================================================= */

let languageApplySequence = 0;

async function applyLanguage(language, showNotice = true) {
    if (!languageNames[language]) return;

    const sequence = ++languageApplySequence;
    let t;

    try {
        t = await loadTranslation(language);
    } catch (error) {
        console.error("Translation loading failed:", error);

        if (showNotice) {
            notify(
                currentTranslations()?.translationLoadError ||
                "Could not load this language. Check its JSON file."
            );
        }

        return;
    }

    if (sequence !== languageApplySequence) return;

    state.language = language;

    try {
        localStorage.setItem("cartman-language", language);
    } catch {
        // Language remains active for this session.
    }

    const languageLabel = $("#language-label");

    if (languageLabel) {
        languageLabel.replaceChildren(createFlagImage(language));
        languageLabel.title = languageNames[language];
        languageLabel.setAttribute(
            "aria-label",
            languageNames[language]
        );
    }

    const navTranslations = {
        Home: t.overview,
        Devices: t.devices,
        Inventory: t.inventory,
        Software: t.software,
        "Remote Access": t.remote,
        Monitoring: t.monitoring,
        Ticketing: t.ticketing,
        "Knowledge Base": t.knowledge,
        "Tasks & Automation": t.tasks,
        Services: t.services,
        "Identity & Access": t.identity,
        Policies: t.policies,
        "Audit Logs": t.audit,
        Settings: t.settings
    };

    $$("[data-page]").forEach(element => {
        const labelText = navTranslations[element.dataset.page];
        if (typeof labelText !== "string") return;

        const textNode = [...element.childNodes].find(node =>
            node.nodeType === Node.TEXT_NODE &&
            node.textContent.trim()
        );

        if (textNode) {
            textNode.textContent = ` ${labelText} `;
        } else if (element.classList.contains("category-card")) {
            const title = $("strong", element);
            if (title) title.textContent = labelText;
        }
    });

    setText("#breadcrumb-page", getModuleLabel(state.module));
    setText(".welcome h1", t.welcome);
    setText(".welcome > p", t.intro);
    setText(".section-heading h2", t.environment);
    setText(".section-heading p", t.environmentSub);
    setText("#refresh-dashboard", t.refresh);
    setText(".modules-heading h2", t.modules);
    setText(".modules-heading p", t.modulesSub);
    setText("#no-results", t.noResults);
    setText("#back-home", t.backHome);
    setText("#module-open-terminal", t.openTerminal);

    const search = $("#global-search");
    if (search) search.placeholder = t.searchPlaceholder || "";

    const terminalButton = $("#terminal-toggle");
    const terminalText = terminalButton?.querySelector("span:last-child");

    if (terminalText && typeof t.terminal === "string") {
        terminalText.textContent = t.terminal;
    }

    if (state.module !== "Home") {
        setText("#module-title", getModuleLabel(state.module));
        setText(
            "#module-description",
            t.moduleDescriptions?.[state.module] ||
            moduleDescriptions[state.module] ||
            ""
        );
        setText("#module-state-title", t.modulePreview || "Module preview");
        setText(
            "#module-state-description",
            t.previewDescription || ""
        );
    }

    document.documentElement.lang = language;
    document.documentElement.dir =
        ["ar", "he"].includes(language) ? "rtl" : "ltr";

    applyTheme(state.theme);
    closeDropdowns();

    $$("#language-menu [data-language]").forEach(button => {
        button.classList.toggle(
            "selected",
            button.dataset.language === language
        );
    });

    if (state.module === "Devices") {
        renderDevicesModule();
    }
}

/* =========================================================
   NAVIGATION
   ========================================================= */

function setModulePlaceholderVisible(visible) {
    const placeholder = $(".module-placeholder", $("#module-view"));
    if (placeholder) placeholder.classList.toggle("hidden", !visible);
}

function openHome() {
    state.module = "Home";

    $("#home-view")?.classList.remove("hidden");
    $("#module-view")?.classList.add("hidden");

    setText("#breadcrumb-page", getModuleLabel("Home"));

    $$(".nav-link").forEach(link => {
        link.classList.toggle("active", link.dataset.page === "Home");
    });

    setMenu(false);
    setTerminal(false);
    closeDropdowns();

    history.replaceState(null, "", "/");
}

function openModule(name) {
    if (name === "Home") {
        openHome();
        return;
    }

    if (!moduleTranslationKeys[name]) return;

    state.module = name;

    $("#home-view")?.classList.add("hidden");
    $("#module-view")?.classList.remove("hidden");

    setText("#module-title", getModuleLabel(name));
    setText(
        "#module-description",
        currentTranslations()?.moduleDescriptions?.[name] ||
        moduleDescriptions[name] ||
        ""
    );
    setText("#breadcrumb-page", getModuleLabel(name));

    const icon = $("#module-icon");
    if (icon) icon.textContent = moduleIcons[name] || "◈";

    $$(".nav-link").forEach(link => {
        link.classList.toggle("active", link.dataset.page === name);
    });

    $("#devices-workspace")?.remove();

    const content = $("#module-page-content");
    if (content) content.replaceChildren();

    if (name === "Devices") {
        setModulePlaceholderVisible(false);
        renderDevicesModule();
    } else {
        setModulePlaceholderVisible(true);

        if (content) {
            const placeholder = document.createElement("div");
            placeholder.className = "module-placeholder";

            const title = document.createElement("h2");
            title.textContent = getModuleLabel(name);

            const description = document.createElement("p");
            description.textContent =
                currentTranslations()?.moduleDescriptions?.[name] ||
                moduleDescriptions[name] ||
                "This module is being developed.";

            placeholder.append(title, description);
            content.appendChild(placeholder);
        }
    }

    setMenu(false);
    setTerminal(false);
    closeDropdowns();

    const slug = name
        .toLowerCase()
        .replaceAll("&", "and")
        .replaceAll(" ", "-");

    history.replaceState(null, "", `/#${slug}`);
}

/* =========================================================
   GLOBAL SEARCH
   ========================================================= */

function filterModules() {
    const query = ($("#global-search")?.value || "")
        .trim()
        .toLocaleLowerCase(state.language);

    const cards = $$(".category-card");
    let visible = 0;

    cards.forEach(card => {
        const matches = card.textContent
            .toLocaleLowerCase(state.language)
            .includes(query);

        card.classList.toggle("hidden", !matches);
        if (matches) visible++;
    });

    $("#no-results")?.classList.toggle("hidden", visible > 0);

    if (query && state.module !== "Home") openHome();
}

/* =========================================================
   TERMINAL PREVIEW
   ========================================================= */

function setTerminal(open) {
    document.body.classList.toggle("terminal-open", open);
    $("#terminal-panel")?.setAttribute("aria-hidden", String(!open));
    $("#terminal-toggle")?.setAttribute("aria-expanded", String(open));

    if (open) {
        setMenu(false);
        closeDropdowns();
        window.setTimeout(() => $("#terminal-command")?.focus(), 50);
    }
}

function addTerminalLine(message, className = "") {
    const output = $("#terminal-output");
    if (!output) return;

    const line = document.createElement("p");
    line.textContent = message;

    if (className) line.className = className;

    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
}

function clearTerminal() {
    $("#terminal-output")?.replaceChildren();
}

function terminalMessage(key, fallback = "") {
    const messages = currentTranslations()?.terminalMessages;

    return typeof messages?.[key] === "string"
        ? messages[key]
        : fallback;
}

function printHelp() {
    addTerminalLine(
        terminalMessage("title", "Cartman CLI — preview mode"),
        "terminal-success"
    );
    addTerminalLine("");
    addTerminalLine(
        terminalMessage("availableCommands", "Available commands:")
    );
    addTerminalLine(
        "  help          " +
        terminalMessage("help", "Show this help")
    );
    addTerminalLine(
        "  clear         " +
        terminalMessage("clear", "Clear terminal output")
    );
    addTerminalLine(
        "  get status    " +
        terminalMessage("status", "Check the Cartman API")
    );
    addTerminalLine(
        "  get devices   " +
        terminalMessage("devices", "Show demo inventory status")
    );
    addTerminalLine(
        "  get tickets   " +
        terminalMessage("tickets", "Show demo ticket counts")
    );
    addTerminalLine(
        "  modules       " +
        terminalMessage("modules", "List available modules")
    );
    addTerminalLine(
        "  whoami        " +
        terminalMessage("whoami", "Show demo session")
    );
    addTerminalLine(
        "  date          " +
        terminalMessage("date", "Show local date and time")
    );
    addTerminalLine(
        "  open <module> " +
        terminalMessage("open", "Open a module")
    );
    addTerminalLine("");
    addTerminalLine(
        terminalMessage(
            "noRemoteCommands",
            "Remote device commands are not implemented."
        ),
        "terminal-muted"
    );
}

async function executeCommand(raw) {
    const command = raw.trim();
    if (!command) return;

    addTerminalLine(`cartman > ${command}`);

    const parts = command.split(/\s+/);
    const first = parts[0].toLowerCase();
    const second = parts[1]?.toLowerCase();

    if (first === "help") {
        printHelp();
        return;
    }

    if (first === "clear") {
        clearTerminal();
        return;
    }

    if (first === "date") {
        addTerminalLine(
            new Date().toLocaleString(state.language),
            "terminal-success"
        );
        return;
    }

    if (first === "whoami") {
        addTerminalLine(
            terminalMessage(
                "user",
                "Kaan Yaşar · Administrator (demo UI)"
            ),
            "terminal-success"
        );
        return;
    }

    if (first === "modules") {
        addTerminalLine(
            ["Home", ...Object.keys(moduleDescriptions)]
                .map(getModuleLabel)
                .join(" · "),
            "terminal-success"
        );
        return;
    }

    if (first === "open") {
        const requested = parts.slice(1).join(" ").toLowerCase();

        const match = Object.keys(moduleDescriptions).find(name =>
            name.toLowerCase() === requested ||
            getModuleLabel(name).toLowerCase() === requested
        );

        if (requested === "home" || requested === "overview") {
            openHome();
            addTerminalLine(
                terminalMessage("openedOverview", "Opened Overview."),
                "terminal-success"
            );
        } else if (match) {
            openModule(match);
            addTerminalLine(
                `${terminalMessage("opened", "Opened")} ${getModuleLabel(match)}.`,
                "terminal-success"
            );
        } else {
            addTerminalLine(
                terminalMessage(
                    "moduleNotFound",
                    "Module not found. Type 'modules'."
                ),
                "terminal-error"
            );
        }

        return;
    }

    if (first === "get" && second === "status") {
        addTerminalLine(
            terminalMessage("checkingApi", "Checking Cartman API..."),
            "terminal-muted"
        );

        try {
            const response = await fetch("/api/health", {
                headers: { Accept: "application/json" }
            });

            if (!response.ok) throw new Error("API request failed");

            const data = await response.json();

            addTerminalLine(`Application: ${data.app}`, "terminal-success");
            addTerminalLine(`Status: ${data.status}`, "terminal-success");
        } catch {
            addTerminalLine(
                terminalMessage(
                    "apiUnavailable",
                    "API unavailable. Check the backend server."
                ),
                "terminal-error"
            );
        }

        return;
    }

    if (first === "get" && second === "devices") {
        const devices = getDeviceData();
        const online = devices.filter(device => device.status === "Online").length;
        const warning = devices.filter(device => device.status === "Warning").length;
        const offline = devices.filter(device => device.status === "Offline").length;

        addTerminalLine(
            `Demo inventory: ${devices.length} devices, ${online} online, ${warning} warning, ${offline} offline.`,
            "terminal-muted"
        );
        addTerminalLine(
            terminalMessage(
                "sampleData",
                "These are sample values, not live endpoint data."
            )
        );

        return;
    }

    if (first === "get" && second === "tickets") {
        addTerminalLine(
            terminalMessage(
                "demoTickets",
                "Demo ticket queue: 5 open, 3 in progress, 12 resolved."
            ),
            "terminal-muted"
        );
        addTerminalLine(
            terminalMessage(
                "ticketingOffline",
                "Ticketing backend is not connected."
            )
        );
        return;
    }

    addTerminalLine(
        terminalMessage(
            "unknownCommand",
            "Unknown command. Type 'help' for available commands."
        ),
        "terminal-error"
    );
}

/* =========================================================
   API STATUS
   ========================================================= */

async function checkApiStatus() {
    const status = $("#api-status");
    if (!status) return;

    status.textContent = translate("apiChecking", "Checking...");
    status.style.color = "";

    try {
        const response = await fetch("/api/health", {
            headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("API request failed");

        const data = await response.json();

        status.textContent = data.status === "online"
            ? translate("apiOnline", "Online")
            : data.status;

        status.style.color = data.status === "online"
            ? "var(--green)"
            : "var(--red)";
    } catch {
        status.textContent = translate("apiOffline", "Offline");
        status.style.color = "var(--red)";
    }
}

/* =========================================================
   DEVICES — LOCAL DEMO INVENTORY
   ========================================================= */

const DEVICE_STORAGE_KEY = "cartman-devices-v1";
const DEVICE_TAG_STORAGE_KEY = "cartman-device-tags-v1";

const DEFAULT_DEVICE_TAGS = [
    "Server",
    "Workstation",
    "Laptop",
    "Network",
    "Virtual Machine",
    "Production",
    "Development",
    "Critical"
];

const DEVICE_STARTER_DATA = [
    {
        id: "device-001",
        name: "SRV-DC01",
        os: "Windows Server 2022",
        ip: "192.168.1.10",
        status: "Online",
        tags: ["Server", "Production", "Critical"]
    },
    {
        id: "device-002",
        name: "SRV-WEB01",
        os: "Ubuntu Server 24.04",
        ip: "192.168.1.20",
        status: "Online",
        tags: ["Server", "Virtual Machine", "Production"]
    },
    {
        id: "device-003",
        name: "WS-ADMIN01",
        os: "Windows 11",
        ip: "192.168.1.30",
        status: "Warning",
        tags: ["Workstation", "Critical"]
    },
    {
        id: "device-004",
        name: "MAC-MINI01",
        os: "macOS",
        ip: "192.168.1.40",
        status: "Online",
        tags: ["Workstation", "Development"]
    },
    {
        id: "device-005",
        name: "LNX-TOOLS01",
        os: "Ubuntu 24.04",
        ip: "192.168.1.50",
        status: "Offline",
        tags: ["Virtual Machine", "Development"]
    }
];

const deviceViewState = {
    filter: "All devices",
    search: "",
    editingId: null
};

function escapeDeviceHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[character]);
}

function loadDeviceData() {
    try {
        const stored = localStorage.getItem(DEVICE_STORAGE_KEY);

        if (stored !== null) {
            const parsed = JSON.parse(stored);

            if (Array.isArray(parsed)) {
                return parsed.filter(device =>
                    device &&
                    typeof device.id === "string" &&
                    typeof device.name === "string" &&
                    typeof device.os === "string" &&
                    typeof device.ip === "string" &&
                    typeof device.status === "string" &&
                    Array.isArray(device.tags) &&
                    device.tags.every(tag => typeof tag === "string")
                );
            }
        }
    } catch (error) {
        console.warn("Could not load Cartman demo devices:", error);
    }

    return DEVICE_STARTER_DATA.map(device => ({
        ...device,
        tags: [...device.tags]
    }));
}

function saveDeviceData(devices) {
    try {
        localStorage.setItem(DEVICE_STORAGE_KEY, JSON.stringify(devices));
        return true;
    } catch (error) {
        console.error("Could not save Cartman demo devices:", error);
        notify("Could not save demo inventory in this browser.");
        return false;
    }
}

function loadDeviceTags() {
    try {
        const stored = localStorage.getItem(DEVICE_TAG_STORAGE_KEY);

        if (stored !== null) {
            const parsed = JSON.parse(stored);

            if (
                Array.isArray(parsed) &&
                parsed.every(tag => typeof tag === "string")
            ) {
                return [...new Set([...DEFAULT_DEVICE_TAGS, ...parsed])];
            }
        }
    } catch (error) {
        console.warn("Could not load Cartman demo tags:", error);
    }

    return [...DEFAULT_DEVICE_TAGS];
}

function saveDeviceTags(tags) {
    try {
        localStorage.setItem(
            DEVICE_TAG_STORAGE_KEY,
            JSON.stringify([...new Set(tags)])
        );
        return true;
    } catch (error) {
        console.error("Could not save Cartman demo tags:", error);
        notify("Could not save tags in this browser.");
        return false;
    }
}

function getDeviceData() {
    return loadDeviceData();
}


function exportDevicesJSON() {
    const payload = {
        version: 1,
        exportedAt: new Date().toISOString(),
        devices: getDeviceData()
    };

    const blob = new Blob(
        [JSON.stringify(payload, null, 2)],
        { type: "application/json" }
    );

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `cartman-devices-${new Date()
        .toISOString()
        .slice(0, 10)}.json`;

    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);

    notify("Device inventory exported.");
}

async function importDevicesJSON(file) {
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
        notify("JSON file must be smaller than 5 MB.");
        return;
    }

    let parsed;

    try {
        parsed = JSON.parse(await file.text());
    } catch {
        notify("Invalid JSON file.");
        return;
    }

    const imported = Array.isArray(parsed)
        ? parsed
        : parsed?.devices;

    if (!Array.isArray(imported) || imported.length > 5000) {
        notify("Invalid device list or too many devices (max 5000).");
        return;
    }

    const allowedStatuses = ["Online", "Warning", "Offline"];

    const valid = imported.every(device =>
        device &&
        typeof device === "object" &&
        !Array.isArray(device) &&
        typeof device.name === "string" &&
        device.name.trim().length > 0 &&
        device.name.trim().length <= 100 &&
        typeof device.os === "string" &&
        device.os.trim().length > 0 &&
        device.os.trim().length <= 100 &&
        (device.ip == null ||
            (typeof device.ip === "string" && device.ip.length <= 100)) &&
        (device.status == null ||
            allowedStatuses.includes(device.status)) &&
        (device.tags == null ||
            (Array.isArray(device.tags) &&
                device.tags.length <= 100 &&
                device.tags.every(tag =>
                    typeof tag === "string" &&
                    tag.trim().length > 0 &&
                    tag.length <= 40
                )))
    );

    if (!valid) {
        notify("JSON contains invalid device data.");
        return;
    }

    const existing = getDeviceData();
    const existingNames = new Set(
        existing.map(device => device.name.trim().toLowerCase())
    );

    const newDevices = [];
    const importedNames = new Set();

    for (const device of imported) {
        const name = device.name.trim();
        const normalizedName = name.toLowerCase();

        if (
            existingNames.has(normalizedName) ||
            importedNames.has(normalizedName)
        ) {
            continue;
        }

        importedNames.add(normalizedName);

        newDevices.push({
            id: `device-${Date.now()}-${Math.random()
                .toString(36).slice(2, 10)}`,
            name,
            os: device.os.trim(),
            ip: typeof device.ip === "string" ? device.ip.trim() : "",
            status: device.status || "Online",
            tags: [...new Set(
                (device.tags || []).map(tag => tag.trim())
            )]
        });
    }

    if (!newDevices.length) {
        notify("No new devices to import.");
        return;
    }

    if (!window.confirm(
        `Import ${newDevices.length} new device(s)? Existing devices will be kept.`
    )) {
        return;
    }

    const combined = [...existing, ...newDevices];

    if (!saveDeviceData(combined)) return;

    const allTags = [
        ...getDeviceTags(),
        ...newDevices.flatMap(device => device.tags)
    ];

    if (!saveDeviceTags(allTags)) {
        notify("Devices imported, but saving tags failed.");
    }

    deviceViewState.filter = "All devices";
    deviceViewState.search = "";

    renderDevicesModule();
    notify(`${newDevices.length} device(s) imported.`);
}


function getDeviceTags() {
    const tags = new Set(loadDeviceTags());

    getDeviceData().forEach(device => {
        device.tags.forEach(tag => tags.add(tag));
    });

    return [...tags].sort((a, b) => a.localeCompare(b));
}

function getDeviceStatusClass(status) {
    if (status === "Online") return "healthy";
    if (status === "Warning") return "warning-pill";
    return "gray";
}

function getDeviceSymbolClass(tags) {
    if (tags.includes("Server")) return "purple";
    if (tags.includes("Laptop")) return "cyan";
    if (tags.includes("Network")) return "orange";
    if (tags.includes("Virtual Machine")) return "blue";
    return "green";
}

function getDeviceSymbol(tags) {
    if (tags.includes("Server")) return "SV";
    if (tags.includes("Laptop")) return "LP";
    if (tags.includes("Network")) return "NW";
    if (tags.includes("Virtual Machine")) return "VM";
    return "DV";
}

function getDeviceFilteredData() {
    const query = deviceViewState.search.trim().toLowerCase();

    return getDeviceData().filter(device => {
        const matchesTag =
            deviceViewState.filter === "All devices" ||
            device.tags.includes(deviceViewState.filter);

        const searchable = [
            device.name,
            device.os,
            device.ip,
            device.status,
            ...device.tags
        ].join(" ").toLowerCase();

        return matchesTag && (!query || searchable.includes(query));
    });
}

function renderDeviceStats() {
    const devices = getDeviceData();

    const total = devices.length;
    const online = devices.filter(device => device.status === "Online").length;
    const warning = devices.filter(device => device.status === "Warning").length;
    const offline = devices.filter(device => device.status === "Offline").length;

    return `
        <div class="devices-stats">
            <div class="devices-stat">
                <div class="devices-stat-label">Total devices</div>
                <div class="devices-stat-value">${total}</div>
            </div>
            <div class="devices-stat">
                <div class="devices-stat-label">Online</div>
                <div class="devices-stat-value online">${online}</div>
            </div>
            <div class="devices-stat">
                <div class="devices-stat-label">Warning</div>
                <div class="devices-stat-value warning">${warning}</div>
            </div>
            <div class="devices-stat">
                <div class="devices-stat-label">Offline</div>
                <div class="devices-stat-value offline">${offline}</div>
            </div>
        </div>
    `;
}

function renderDeviceTags() {
    const tags = getDeviceTags();
    const devices = getDeviceData();

    const allButton = `
        <button
            type="button"
            class="device-tag ${deviceViewState.filter === "All devices" ? "active" : ""}"
            data-device-filter="All devices"
        >
            All devices
            <span class="device-tag-count">${devices.length}</span>
        </button>
    `;

    const tagButtons = tags.map(tag => {
        const count = devices.filter(device =>
            device.tags.includes(tag)
        ).length;

        return `
            <button
                type="button"
                class="device-tag ${deviceViewState.filter === tag ? "active" : ""}"
                data-device-filter="${escapeDeviceHTML(tag)}"
            >
                ${escapeDeviceHTML(tag)}
                <span class="device-tag-count">${count}</span>
            </button>
        `;
    }).join("");

    return `
        <section class="devices-tags-panel">
            <div class="devices-panel-heading">
                <div>
                    <h2>Device tags</h2>
                    <p>Filter devices by type, environment or priority.</p>
                </div>
                <button type="button" class="secondary-button" data-device-action="manage-tags">
                    Manage tags
                </button>
            </div>
            <div class="devices-tag-list">
                ${allButton}
                ${tagButtons}
            </div>
        </section>
    `;
}

function renderDeviceRows() {
    const devices = getDeviceFilteredData();

    if (!devices.length) {
        return `
            <tr>
                <td colspan="6">
                    <div class="devices-empty">
                        <strong>No devices found</strong>
                        Try a different search or tag filter.
                    </div>
                </td>
            </tr>
        `;
    }

    return devices.map(device => {
        const symbolClass = getDeviceSymbolClass(device.tags);
        const symbol = getDeviceSymbol(device.tags);

        const tags = device.tags.length
            ? device.tags.map(tag => `
                <span class="device-row-tag">${escapeDeviceHTML(tag)}</span>
            `).join("")
            : `<span class="device-row-tag">Untagged</span>`;

        return `
            <tr>
                <td>
                    <div class="device-name-cell">
                        <div class="device-symbol ${symbolClass}">${symbol}</div>
                        <div>
                            <strong>${escapeDeviceHTML(device.name)}</strong>
                            <small>${escapeDeviceHTML(device.id)}</small>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="device-os-cell">
                        <span>${escapeDeviceHTML(device.os)}</span>
                    </div>
                </td>
                <td>
                    <span class="device-ip">${escapeDeviceHTML(device.ip || "—")}</span>
                </td>
                <td>
                    <span class="status-pill ${getDeviceStatusClass(device.status)}">
                        ${escapeDeviceHTML(device.status)}
                    </span>
                </td>
                <td><div class="device-row-tags">${tags}</div></td>
                <td>
                    <div class="device-actions">
                        <button
                            type="button"
                            class="device-action-button"
                            title="Edit device"
                            aria-label="Edit ${escapeDeviceHTML(device.name)}"
                            data-device-action="edit"
                            data-device-id="${escapeDeviceHTML(device.id)}"
                        >✎</button>
                        <button
                            type="button"
                            class="device-action-button delete"
                            title="Delete device"
                            aria-label="Delete ${escapeDeviceHTML(device.name)}"
                            data-device-action="delete"
                            data-device-id="${escapeDeviceHTML(device.id)}"
                        >×</button>
                    </div>
                </td>
            </tr>
        `;
    }).join("");
}

function renderDevicesModule() {
    const moduleView = $("#module-view");
    if (!moduleView || state.module !== "Devices") return;

    setModulePlaceholderVisible(false);

    let workspace = $("#devices-workspace");

    if (!workspace) {
        workspace = document.createElement("div");
        workspace.id = "devices-workspace";
        workspace.className = "devices-workspace";
        moduleView.appendChild(workspace);
    }

    workspace.innerHTML = `
        ${renderDeviceStats()}

        <div class="devices-toolbar">
            <div class="devices-toolbar-left">
                <label class="devices-search">
                    <span aria-hidden="true">⌕</span>
                    <input
                        type="search"
                        id="devices-search-input"
                        placeholder="Search name, OS, IP or tag..."
                        value="${escapeDeviceHTML(deviceViewState.search)}"
                        aria-label="Search devices"
                    >
                </label>
            </div>
            <div class="devices-toolbar-right">
                <button type="button" class="secondary-button" data-device-action="reset">
                    Reset demo data
                </button>
                <button type="button" class="primary-button" data-device-action="add">
                    ＋ Add device
                </button>
            </div>
        </div>

        ${renderDeviceTags()}

        <section class="devices-table-panel">
            <div class="devices-panel-heading">
                <div>
                    <h2>Device inventory</h2>
                    <p>Manage demo endpoints and their tags.</p>
                </div>
                <span class="section-count">
                    ${getDeviceFilteredData().length} SHOWN
                </span>
            </div>

            <div class="devices-table-wrap">
                <table class="devices-table">
                    <thead>
                        <tr>
                            <th>DEVICE</th>
                            <th>OPERATING SYSTEM</th>
                            <th>IP ADDRESS</th>
                            <th>STATUS</th>
                            <th>TAGS</th>
                            <th style="text-align:right">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>${renderDeviceRows()}</tbody>
                </table>
            </div>
        </section>

        <p style="color:var(--muted);font-size:10px;margin:0">
            Demo inventory only. No real endpoint is contacted or modified.
        </p>
    `;
}

function openDeviceModal(device = null) {
    const editing = Boolean(device);
    deviceViewState.editingId = device?.id || null;

    $("#devices-modal-backdrop")?.remove();

    const selectedTags = new Set(device?.tags || []);
    const tags = getDeviceTags();

    const tagOptions = tags.map(tag => `
        <label class="device-tag-option">
            <input
                type="checkbox"
                name="device-tags"
                value="${escapeDeviceHTML(tag)}"
                ${selectedTags.has(tag) ? "checked" : ""}
            >
            <span>${escapeDeviceHTML(tag)}</span>
        </label>
    `).join("");

    const backdrop = document.createElement("div");
    backdrop.id = "devices-modal-backdrop";
    backdrop.className = "devices-modal-backdrop";

    backdrop.innerHTML = `
        <section
            class="devices-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="device-modal-title"
        >
            <header class="devices-modal-header">
                <div>
                    <h2 id="device-modal-title">${editing ? "Edit device" : "Add device"}</h2>
                    <p>Update the demo inventory entry.</p>
                </div>
                <button
                    type="button"
                    class="device-action-button"
                    data-device-action="close-modal"
                    aria-label="Close dialog"
                >×</button>
            </header>

            <form id="device-form">
                <div class="devices-modal-body">
                    <div class="device-form-field">
                        <label for="device-name">Device name *</label>
                        <input
                            id="device-name"
                            name="name"
                            required
                            maxlength="100"
                            autocomplete="off"
                            placeholder="e.g. SRV-APP01"
                            value="${escapeDeviceHTML(device?.name || "")}"
                        >
                    </div>

                    <div class="device-form-grid">
                        <div class="device-form-field">
                            <label for="device-os">Operating system *</label>
                            <input
                                id="device-os"
                                name="os"
                                required
                                maxlength="100"
                                placeholder="e.g. Ubuntu Server 24.04"
                                value="${escapeDeviceHTML(device?.os || "")}"
                            >
                        </div>

                        <div class="device-form-field">
                            <label for="device-ip">IP address</label>
                            <input
                                id="device-ip"
                                name="ip"
                                maxlength="100"
                                placeholder="e.g. 192.168.1.60"
                                value="${escapeDeviceHTML(device?.ip || "")}"
                            >
                        </div>
                    </div>

                    <div class="device-form-field">
                        <label for="device-status">Status</label>
                        <select id="device-status" name="status">
                            ${["Online", "Warning", "Offline"].map(status => `
                                <option
                                    value="${status}"
                                    ${(device?.status || "Online") === status ? "selected" : ""}
                                >${status}</option>
                            `).join("")}
                        </select>
                    </div>

                    <div class="device-form-field">
                        <span class="device-form-label">Tags</span>
                        <div class="device-form-tags" id="device-form-tags">
                            ${tagOptions}
                        </div>
                        <div class="device-custom-tag-row">
                            <input
                                id="device-new-tag"
                                maxlength="40"
                                placeholder="Create a custom tag..."
                            >
                            <button
                                type="button"
                                class="secondary-button"
                                data-device-action="add-tag-from-form"
                            >＋ Add tag</button>
                        </div>
                    </div>
                </div>

                <footer class="devices-modal-footer">
                    <button
                        type="button"
                        class="secondary-button"
                        data-device-action="close-modal"
                    >Cancel</button>
                    <button type="submit" class="primary-button">
                        ${editing ? "Save changes" : "Add device"}
                    </button>
                </footer>
            </form>
        </section>
    `;

    document.body.appendChild(backdrop);
    $("#device-name")?.focus();
}

function addCustomDeviceTag() {
    const input = $("#device-new-tag");
    if (!input) return;

    const tag = input.value.trim();

    if (!tag) {
        input.focus();
        return;
    }

    const tags = getDeviceTags();

    if (tags.some(existing => existing.toLowerCase() === tag.toLowerCase())) {
        notify("That tag already exists.");
        input.focus();
        return;
    }

    tags.push(tag);
    if (!saveDeviceTags(tags)) return;

    const container = $("#device-form-tags");

    if (container) {
        const label = document.createElement("label");
        label.className = "device-tag-option";

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.name = "device-tags";
        checkbox.value = tag;
        checkbox.checked = true;

        const span = document.createElement("span");
        span.textContent = tag;

        label.append(checkbox, span);
        container.appendChild(label);
    }

    input.value = "";
    input.focus();
}

function saveDeviceForm(event) {
    event.preventDefault();

    const form = $("#device-form");
    if (!form || !form.reportValidity()) return;

    const formData = new FormData(form);

    const name = String(formData.get("name") || "").trim();
    const os = String(formData.get("os") || "").trim();
    const ip = String(formData.get("ip") || "").trim();
    const status = String(formData.get("status") || "Online");

    const tags = $$('input[name="device-tags"]:checked', form)
        .map(input => input.value);

    if (!name || !os) {
        notify("Device name and operating system are required.");
        return;
    }

    const devices = getDeviceData();
    const editingId = deviceViewState.editingId;

    if (devices.some(device =>
        device.name.toLowerCase() === name.toLowerCase() &&
        device.id !== editingId
    )) {
        notify("A device with that name already exists.");
        return;
    }

    if (editingId) {
        const index = devices.findIndex(device => device.id === editingId);

        if (index === -1) {
            notify("Device not found.");
            return;
        }

        devices[index] = {
            ...devices[index],
            name,
            os,
            ip,
            status,
            tags
        };
    } else {
        devices.push({
            id: `device-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
            name,
            os,
            ip,
            status,
            tags
        });
    }

    if (!saveDeviceData(devices)) return;

    $("#devices-modal-backdrop")?.remove();
    deviceViewState.editingId = null;

    renderDevicesModule();
    notify(editingId ? "Device updated." : "Device added.");
}

function deleteDevice(id) {
    const devices = getDeviceData();
    const device = devices.find(item => item.id === id);

    if (!device) return;

    if (!window.confirm(`Delete "${device.name}" from the demo inventory?`)) {
        return;
    }

    if (!saveDeviceData(devices.filter(item => item.id !== id))) return;

    renderDevicesModule();
    notify("Device removed from demo inventory.");
}

function resetDeviceDemoData() {
    if (!window.confirm("Reset the device list to the original demo data?")) {
        return;
    }

    const starterData = DEVICE_STARTER_DATA.map(device => ({
        ...device,
        tags: [...device.tags]
    }));

    if (!saveDeviceData(starterData)) return;

    deviceViewState.filter = "All devices";
    deviceViewState.search = "";

    renderDevicesModule();
    notify("Demo inventory reset.");
}

function openManageDeviceTags() {
    $("#devices-modal-backdrop")?.remove();

    const backdrop = document.createElement("div");
    backdrop.id = "devices-modal-backdrop";
    backdrop.className = "devices-modal-backdrop";

    backdrop.innerHTML = `
        <section
            class="devices-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="device-tags-title"
        >
            <header class="devices-modal-header">
                <div>
                    <h2 id="device-tags-title">Manage tags</h2>
                    <p>Organize devices by type, environment or priority.</p>
                </div>
                <button
                    type="button"
                    class="device-action-button"
                    data-device-action="close-modal"
                    aria-label="Close dialog"
                >×</button>
            </header>

            <div class="devices-modal-body">
                <div class="device-custom-tag-row">
                    <input
                        id="manage-new-device-tag"
                        maxlength="40"
                        placeholder="Enter a new tag..."
                    >
                    <button
                        type="button"
                        class="primary-button"
                        data-device-action="create-managed-tag"
                    >Add tag</button>
                </div>

                <div class="devices-manage-tags">
                    ${getDeviceTags().map(tag => {
                        const inUse = getDeviceData().some(device =>
                            device.tags.includes(tag)
                        );

                        return `
                            <div class="devices-manage-tag-row">
                                <span>${escapeDeviceHTML(tag)}</span>
                                <button
                                    type="button"
                                    class="device-action-button delete"
                                    data-device-action="delete-tag"
                                    data-device-tag="${escapeDeviceHTML(tag)}"
                                    ${inUse ? "disabled title='This tag is assigned to a device'" : ""}
                                    aria-label="Delete ${escapeDeviceHTML(tag)}"
                                >×</button>
                            </div>
                        `;
                    }).join("")}
                </div>
            </div>

            <footer class="devices-modal-footer">
                <button
                    type="button"
                    class="secondary-button"
                    data-device-action="close-modal"
                >Close</button>
            </footer>
        </section>
    `;

    document.body.appendChild(backdrop);
}

function createManagedDeviceTag() {
    const input = $("#manage-new-device-tag");
    if (!input) return;

    const tag = input.value.trim();

    if (!tag) {
        input.focus();
        return;
    }

    const tags = getDeviceTags();

    if (tags.some(existing => existing.toLowerCase() === tag.toLowerCase())) {
        notify("That tag already exists.");
        input.focus();
        return;
    }

    tags.push(tag);
    if (!saveDeviceTags(tags)) return;

    openManageDeviceTags();
    notify("Tag created.");
}

function deleteManagedDeviceTag(tag) {
    if (DEFAULT_DEVICE_TAGS.includes(tag)) {
        notify("Default tags cannot be deleted.");
        return;
    }

    if (getDeviceData().some(device => device.tags.includes(tag))) {
        notify("Remove this tag from its devices before deleting it.");
        return;
    }

    if (!saveDeviceTags(getDeviceTags().filter(item => item !== tag))) return;

    openManageDeviceTags();
    renderDevicesModule();
    notify("Tag deleted.");
}

/* =========================================================
   EVENT LISTENERS
   ========================================================= */

$("#theme-toggle")?.addEventListener("click", () => {
    applyTheme(state.theme === "dark" ? "light" : "dark");
});

$("#menu-toggle")?.addEventListener("click", () => {
    setMenu(!document.body.classList.contains("menu-open"));
});

$("#page-backdrop")?.addEventListener("click", () => setMenu(false));

$("#profile-toggle")?.addEventListener("click", () => {
    toggleDropdown("#profile-menu", "#profile-toggle");
});

$("#language-toggle")?.addEventListener("click", () => {
    toggleDropdown("#language-menu", "#language-toggle");
});

$("#language-menu")?.addEventListener("click", event => {
    const button = event.target.closest("[data-language]");
    if (!button) return;

    void applyLanguage(button.dataset.language);
});

document.addEventListener("click", event => {
    const page = event.target.closest("[data-page]");

    if (page) {
        event.preventDefault();
        openModule(page.dataset.page);
        return;
    }

    const filterButton = event.target.closest("[data-device-filter]");

    if (filterButton) {
        deviceViewState.filter = filterButton.dataset.deviceFilter;
        renderDevicesModule();
        return;
    }

    const button = event.target.closest("[data-device-action]");
    if (!button) return;

    const action = button.dataset.deviceAction;
    const id = button.dataset.deviceId;

    switch (action) {
        case "add":
            openDeviceModal();
            break;

        case "edit": {
            const device = getDeviceData().find(item => item.id === id);
            if (device) openDeviceModal(device);
            break;
        }

        case "delete":
            deleteDevice(id);
            break;

        case "manage-tags":
            openManageDeviceTags();
            break;

        case "reset":
            resetDeviceDemoData();
            break;

        case "close-modal":
            $("#devices-modal-backdrop")?.remove();
            deviceViewState.editingId = null;
            break;

        case "add-tag-from-form":
            addCustomDeviceTag();
            break;

        case "create-managed-tag":
            createManagedDeviceTag();
            break;

        case "delete-tag":
            deleteManagedDeviceTag(button.dataset.deviceTag);
            break;
    }
});

document.addEventListener("input", event => {
    if (event.target.id !== "global-search") return;
    filterModules();
});

document.addEventListener("input", event => {
    if (event.target.id !== "devices-search-input") return;

    deviceViewState.search = event.target.value;

    const workspace = $("#devices-workspace");
    if (!workspace || state.module !== "Devices") return;

    const tbody = $(".devices-table tbody", workspace);
    if (tbody) tbody.innerHTML = renderDeviceRows();

    const count = $(".devices-table-panel .section-count", workspace);

    if (count) {
        count.textContent = `${getDeviceFilteredData().length} SHOWN`;
    }
});

document.addEventListener("submit", event => {
    if (event.target.id === "device-form") {
        saveDeviceForm(event);
    }

    if (event.target.id === "terminal-form") {
        event.preventDefault();

        const input = $("#terminal-command");
        if (!input) return;

        const command = input.value;
        input.value = "";

        void executeCommand(command).then(() => input.focus());
    }
});

$("#back-home")?.addEventListener("click", openHome);

$("#terminal-toggle")?.addEventListener("click", () => {
    setTerminal(!document.body.classList.contains("terminal-open"));
});

$("#quick-open-terminal")?.addEventListener("click", () => setTerminal(true));
$("#module-open-terminal")?.addEventListener("click", () => setTerminal(true));
$("#terminal-close")?.addEventListener("click", () => setTerminal(false));
$("#terminal-clear")?.addEventListener("click", clearTerminal);

$("#refresh-dashboard")?.addEventListener("click", async () => {
    await checkApiStatus();

    notify(
        translate(
            "dashboardRefreshed",
            "Dashboard status refreshed. Displayed dashboard values are sample data."
        )
    );
});

document.addEventListener("keydown", event => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        $("#global-search")?.focus();
    }

    if (event.key === "Escape") {
        setMenu(false);
        setTerminal(false);
        closeDropdowns();
        $("#devices-modal-backdrop")?.remove();
        deviceViewState.editingId = null;
    }

    if (event.key === "Enter" && event.target.id === "device-new-tag") {
        event.preventDefault();
        addCustomDeviceTag();
    }

    if (event.key === "Enter" && event.target.id === "manage-new-device-tag") {
        event.preventDefault();
        createManagedDeviceTag();
    }
});

/* =========================================================
   INITIALIZATION
   ========================================================= */

async function initializeCartman() {
    try {
        applyTheme(localStorage.getItem("cartman-theme") || "dark");
    } catch {
        applyTheme("dark");
    }

    renderLanguageFlags();

    let savedLanguage = "en";

    try {
        savedLanguage = localStorage.getItem("cartman-language") || "en";
    } catch {
        // Use English if local storage is unavailable.
    }

    try {
        await applyLanguage(
            languageNames[savedLanguage] ? savedLanguage : "en",
            false
        );
    } catch (error) {
        console.error("Language initialization failed:", error);
    }

    await checkApiStatus();

    console.info("Cartman UI initialized.");
}

void initializeCartman();
