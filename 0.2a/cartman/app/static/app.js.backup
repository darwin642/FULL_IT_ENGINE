    en: "English",
    tr: "Türkçe",
    de: "Deutsch",
    fr: "Français",
    es: "Español",
    nl: "Nederlands",
    pl: "Polski",
    it: "Italiano",
    ja: "日本語",
    "pt-BR": "Português",
    ar: "العربية",
    "zh-CN": "简体中文",
    ru: "Русский",
    el: "Ελληνικά",
    bcs: "Bosanski / Hrvatski / Srpski",
    he: "עברית",
    sq: "Shqip",
    cs: "Čeština",
    lt: "Lietuvių",
    sv: "Svenska",
    no: "Norsk bokmål",
    da: "Dansk",
    fi: "Suomi",
    az: "Azərbaycanca",
    id: "Bahasa Indonesia",
    ms: "Bahasa Melayu",
    et: "Eesti",
    hu: "Magyar",
    ko: "한국어"
};

const flagFiles = {
    en: "gb",
    tr: "tr",
    de: "de",
    fr: "fr",
    es: "es",
    nl: "nl",
    pl: "pl",
    it: "it",
    ja: "jp",
    "pt-BR": "pt",
    ar: "sa",
    "zh-CN": "cn",
    ru: "ru",
    el: "gr",
    bcs: "ba",
    he: "il",
    sq: "al",
    cs: "cz",
    lt: "lt",
    sv: "se",
    no: "no",
    da: "dk",
    fi: "fi",
    az: "az",
    id: "id",
    ms: "my",
    et: "ee",
    hu: "hu",
    ko: "kr"
};

const translations = Object.create(null);
const translationRequests = new Map();

async function loadTranslation(language) {
    if (translations[language]) return translations[language];

    if (!translationRequests.has(language)) {
        const request = fetch(
            `/static/translations/${encodeURIComponent(language)}.json`,
            { headers: { Accept: "application/json" } }
        ).then(async response => {
            if (!response.ok) {
                throw new Error(`Translation request failed: ${language}`);
            }

            const data = await response.json();

            if (!data || typeof data !== "object" || Array.isArray(data)) {
                throw new Error(`Invalid translation JSON: ${language}`);
            }

            translations[language] = data;
            return data;
        }).catch(error => {
            translationRequests.delete(language);
            throw error;
        });

        translationRequests.set(language, request);
    }

    return translationRequests.get(language);
}

function currentTranslations() {
    return translations[state.language] || null;
}

function translate(key, fallback = "") {
    const value = currentTranslations()?.[key];
    return typeof value === "string" ? value : fallback;
}

function createFlagImage(language) {
    const file = flagFiles[language];

    if (!file) {
        return document.createTextNode(languageNames[language] || language);
    }

    const image = document.createElement("img");
    image.className = "language-flag";
    image.src = `/static/flags/${file}.svg`;
    image.alt = "";
    image.setAttribute("aria-hidden", "true");
    image.draggable = false;

    image.addEventListener("error", () => {
        image.hidden = true;
    }, { once: true });

    return image;
}

function renderLanguageFlags() {
    $$("#language-menu [data-language]").forEach(button => {
        const language = button.dataset.language;

        button.replaceChildren(createFlagImage(language));
        button.title = languageNames[language] || language;
        button.setAttribute(
            "aria-label",
            languageNames[language] || language
        );
    });
}

/* =========================================================
   THEME
   ========================================================= */

function applyTheme(theme) {
    state.theme = theme === "light" ? "light" : "dark";

    document.body.classList.toggle(
        "light-theme",
        state.theme === "light"
    );

    const label = $("#theme-label");
    const button = $("#theme-toggle");

    if (label) {
        label.textContent = state.theme === "light"
            ? translate("darkMode", "Dark mode")
            : translate("lightMode", "Light mode");
    }

    if (button) {
        if (button.firstChild?.nodeType === Node.TEXT_NODE) {
            button.firstChild.textContent =
                state.theme === "light" ? "☾ " : "☀ ";
        }

        button.setAttribute(
            "aria-label",
            state.theme === "light"
                ? translate("switchToDark", "Switch to dark theme")
                : translate("switchToLight", "Switch to light theme")
        );

        button.setAttribute(
            "aria-pressed",
            String(state.theme === "light")
        );
    }

    try {
        localStorage.setItem("cartman-theme", state.theme);
    } catch {
        // The theme still works for this session.
    }
}

/* =========================================================
   SIDEBAR AND DROPDOWNS
   ========================================================= */

function setMenu(open) {
    document.body.classList.toggle("menu-open", open);
    $("#menu-toggle")?.setAttribute("aria-expanded", String(open));
}

function closeDropdowns(except = null) {
    [
        ["#profile-menu", "#profile-toggle"],
        ["#language-menu", "#language-toggle"]
    ].forEach(([menuSelector, buttonSelector]) => {
        const menu = $(menuSelector);
        const button = $(buttonSelector);

        if (menu && menu !== except) {
            menu.classList.add("hidden");
            button?.setAttribute("aria-expanded", "false");
        }
    });
}

function toggleDropdown(menuSelector, buttonSelector) {
    const menu = $(menuSelector);
    const button = $(buttonSelector);

    if (!menu || !button) return;

    const shouldOpen = menu.classList.contains("hidden");
    closeDropdowns(menu);

    menu.classList.toggle("hidden", !shouldOpen);
    button.setAttribute("aria-expanded", String(shouldOpen));
}

