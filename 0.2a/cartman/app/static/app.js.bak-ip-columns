function addCustomDeviceTag() {
    const input = $("#device-new-tag");
    if (!input) return;

    const tag = input.value.trim();

    if (!tag) {
        input.focus();
        return;
    }

    const tags = getDeviceTags();

    if (tags.some(existing => existing.toLowerCase() === tag.toLowerCase())) {
        notify("That tag already exists.");
        input.focus();
        return;
    }

    tags.push(tag);
    if (!saveDeviceTags(tags)) return;

    const container = $("#device-form-tags");

    if (container) {
        const label = document.createElement("label");
        label.className = "device-tag-option";

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";
        checkbox.name = "device-tags";
        checkbox.value = tag;
        checkbox.checked = true;

        const span = document.createElement("span");
        span.textContent = tag;

        label.append(checkbox, span);
        container.appendChild(label);
    }

    input.value = "";
    input.focus();
}

function saveDeviceForm(event) {
    event.preventDefault();

    const form = $("#device-form");
    if (!form || !form.reportValidity()) return;

    const formData = new FormData(form);

    const name = String(formData.get("name") || "").trim();
    const os = String(formData.get("os") || "").trim();
    const ip = String(formData.get("ip") || "").trim();
    const status = String(formData.get("status") || "Online");
    const assignedValue = String(formData.get("assignedUser") || "");
    const [assignedName, assignedUsername] = assignedValue.split("|");
    const assignedUser = assignedName
        ? { name: assignedName, username: assignedUsername || "" }
        : { name: "Unassigned", username: "" };

    const tags = $$('input[name="device-tags"]:checked', form)
        .map(input => input.value);

    if (!name || !os) {
        notify("Device name and operating system are required.");
        return;
    }

    const devices = getDeviceData();
    const editingId = deviceViewState.editingId;

    if (devices.some(device =>
        device.name.toLowerCase() === name.toLowerCase() &&
        device.id !== editingId
    )) {
        notify("A device with that name already exists.");
        return;
    }

    if (editingId) {
        const index = devices.findIndex(device => device.id === editingId);

        if (index === -1) {
            notify("Device not found.");
            return;
        }

        devices[index] = {
            ...devices[index],
            name,
            os,
            ip,
            status,
            assignedUser,
            tags
        };
    } else {
        devices.push({
            id: `device-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
            name,
            os,
            ip,
            status,
            assignedUser,
            tags
        });
    }

    if (!saveDeviceData(devices)) return;

    $("#devices-modal-backdrop")?.remove();
    deviceViewState.editingId = null;

    renderDevicesModule();
    notify(editingId ? "Device updated." : "Device added.");
}

function deleteDevice(id) {
    const devices = getDeviceData();
    const device = devices.find(item => item.id === id);

    if (!device) return;

    if (!window.confirm(`Delete "${device.name}" from the demo inventory?`)) {
        return;
