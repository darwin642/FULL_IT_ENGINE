async function importDevicesJSON(file) {
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
        notify("JSON file must be smaller than 5 MB.");
        return;
    }

    let parsed;

    try {
        parsed = JSON.parse(await file.text());
    } catch {
        notify("Invalid JSON file.");
        return;
    }

    const imported = Array.isArray(parsed)
        ? parsed
        : parsed?.devices;

    if (!Array.isArray(imported) || imported.length > 5000) {
        notify("Invalid device list or too many devices (max 5000).");
        return;
    }

    const allowedStatuses = ["Online", "Warning", "Offline"];

    const valid = imported.every(device =>
        device &&
        typeof device === "object" &&
        !Array.isArray(device) &&
        typeof device.name === "string" &&
        device.name.trim().length > 0 &&
        device.name.trim().length <= 100 &&
        typeof device.os === "string" &&
        device.os.trim().length > 0 &&
        device.os.trim().length <= 100 &&
        (device.ip == null ||
            (typeof device.ip === "string" && device.ip.length <= 100)) &&
        (device.status == null ||
            allowedStatuses.includes(device.status)) &&
        (device.tags == null ||
            (Array.isArray(device.tags) &&
                device.tags.length <= 100 &&
                device.tags.every(tag =>
                    typeof tag === "string" &&
                    tag.trim().length > 0 &&
                    tag.length <= 40
                )))
    );

    if (!valid) {
        notify("JSON contains invalid device data.");
        return;
    }

    const existing = getDeviceData();
    const existingNames = new Set(
        existing.map(device => device.name.trim().toLowerCase())
    );

    const newDevices = [];
    const importedNames = new Set();

    for (const device of imported) {
        const name = device.name.trim();
        const normalizedName = name.toLowerCase();

        if (
            existingNames.has(normalizedName) ||
            importedNames.has(normalizedName)
        ) {
            continue;
        }

        importedNames.add(normalizedName);

        newDevices.push({
            id: `device-${Date.now()}-${Math.random()
                .toString(36).slice(2, 10)}`,
            name,
            os: device.os.trim(),
            ip: typeof device.ip === "string" ? device.ip.trim() : "",
            status: device.status || "Online",
            tags: [...new Set(
                (device.tags || []).map(tag => tag.trim())
            )]
        });
    }

    if (!newDevices.length) {
        notify("No new devices to import.");
        return;
    }

    if (!window.confirm(
        `Import ${newDevices.length} new device(s)? Existing devices will be kept.`
    )) {
        return;
    }

    const combined = [...existing, ...newDevices];

    if (!saveDeviceData(combined)) return;

    const allTags = [
        ...getDeviceTags(),
        ...newDevices.flatMap(device => device.tags)
    ];

    if (!saveDeviceTags(allTags)) {
        notify("Devices imported, but saving tags failed.");
    }

    deviceViewState.filter = "All devices";
    deviceViewState.search = "";

    renderDevicesModule();
    notify(`${newDevices.length} device(s) imported.`);
}


function getDeviceTags() {
    const tags = new Set(loadDeviceTags());

    getDeviceData().forEach(device => {
        device.tags.forEach(tag => tags.add(tag));
    });

    return [...tags].sort((a, b) => a.localeCompare(b));
}

