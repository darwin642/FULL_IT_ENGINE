            disk: device.disk || (isServer ? "1 TB" : "512 GB"),
            addedAt: device.addedAt || new Date(Date.now() - (index + 2) * 86400000).toISOString(),
            lastSeen: device.lastSeen || (device.status === "Offline" ? null : new Date(Date.now() - index * 3600000).toISOString())
