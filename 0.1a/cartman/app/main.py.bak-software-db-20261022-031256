@app.post("/api/devices/import")
def import_devices(devices: list[DeviceInput]):
    if len(devices) > 5000:
        raise HTTPException(
            status_code=413,
            detail="Maximum 5000 devices per import",
        )

    imported = 0
    skipped = 0

    with get_connection() as connection:
        for device in devices:
            device_id = "device-" + uuid.uuid4().hex

            try:
                connection.execute("""
                    INSERT INTO devices (id, name, os, ip, status, tags)
                    VALUES (?, ?, ?, ?, ?, ?)
                """, (
                    device_id,
                    device.name,
                    device.os,
                    device.ip,
                    device.status,
                    json.dumps(device.tags),
                ))
                imported += 1
            except sqlite3.IntegrityError:
                skipped += 1

    return {"imported": imported, "skipped": skipped}
