function renderWorkspaceModule(name) {
    const content = $("#module-page-content");
    const config = modulePageConfigs[name];

    if (!content || !config) return;

    const section = document.createElement("section");
    section.className = "workspace-module";
    section.dataset.workspaceModule = name;

    const eyebrow = document.createElement("div");
    eyebrow.className = "workspace-eyebrow";
    eyebrow.textContent = config.eyebrow;

    const toolbar = document.createElement("div");
    toolbar.className = "workspace-toolbar";

    const search = document.createElement("input");
    search.type = "search";
    search.className = "workspace-search";
    search.placeholder = `Search ${name.toLowerCase()}...`;
    search.setAttribute("aria-label", `Search ${name}`);

    const stateLabel = document.createElement("span");
    stateLabel.className = "workspace-demo-label";
    stateLabel.textContent = "UI PREVIEW · NO LIVE DATA";

    toolbar.append(search, stateLabel);

    const stats = document.createElement("div");
    stats.className = "workspace-stats";

    config.stats.forEach(([label, value]) => {
        const card = document.createElement("article");
        card.className = "workspace-stat";

        const statLabel = document.createElement("span");
        statLabel.className = "workspace-stat-label";
        statLabel.textContent = label;

        const statValue = document.createElement("strong");
        statValue.className = "workspace-stat-value";
        statValue.textContent = value;

        card.append(statLabel, statValue);
        stats.appendChild(card);
    });

    const panel = document.createElement("div");
    panel.className = "workspace-table-panel";

    const panelHeader = document.createElement("div");
    panelHeader.className = "workspace-panel-header";

    const panelTitle = document.createElement("h2");
    panelTitle.textContent = `${name} overview`;

    const count = document.createElement("span");
    count.className = "workspace-row-count";
    count.textContent = `${config.rows.length} preview row(s)`;

    panelHeader.append(panelTitle, count);

    const tableWrap = document.createElement("div");
    tableWrap.className = "workspace-table-wrap";

    const table = document.createElement("table");
    table.className = "workspace-table";

    const thead = document.createElement("thead");
    const headRow = document.createElement("tr");

    config.columns.forEach(column => {
        const th = document.createElement("th");
        th.textContent = column;
        headRow.appendChild(th);
    });

    thead.appendChild(headRow);

    const tbody = document.createElement("tbody");

    config.rows.forEach(row => {
        const tr = document.createElement("tr");
        tr.dataset.searchText = row.join(" ").toLocaleLowerCase();

        row.forEach((value, index) => {
            const td = document.createElement("td");
            td.textContent = value;

            if (index === row.length - 1) {
                const status = document.createElement("span");
                status.className = "workspace-status";
                status.textContent = value;
                td.replaceChildren(status);
            }

            tr.appendChild(td);
        });

        tbody.appendChild(tr);
    });

    table.append(thead, tbody);
    tableWrap.appendChild(table);

    const empty = document.createElement("p");
    empty.className = "workspace-empty hidden";
    empty.textContent = "No matching rows.";

    panel.append(panelHeader, tableWrap, empty);
    section.append(eyebrow, toolbar, stats, panel);
    content.replaceChildren(section);

    search.addEventListener("input", () => {
        const query = search.value.trim().toLocaleLowerCase();
        let visible = 0;

        tbody.querySelectorAll("tr").forEach(row => {
            const matches = row.dataset.searchText.includes(query);
            row.classList.toggle("hidden", !matches);
            if (matches) visible++;
        });

        empty.classList.toggle("hidden", visible > 0);
        count.textContent = `${visible} row(s)`;
    });
}

