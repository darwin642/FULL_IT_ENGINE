    );
    addTerminalLine(
        "  open <module> " +
        terminalMessage("open", "Open a module")
    );
    addTerminalLine("");
    addTerminalLine(
        terminalMessage(
            "noRemoteCommands",
            "Remote device commands are not implemented."
        ),
        "terminal-muted"
    );
}

async function executeCommand(raw) {
    const command = raw.trim();
    if (!command) return;

    addTerminalLine(`cartman > ${command}`);

    const parts = command.split(/\s+/);
    const first = parts[0].toLowerCase();
    const second = parts[1]?.toLowerCase();

    if (first === "help") {
        printHelp();
        return;
    }

    if (first === "clear") {
        clearTerminal();
        return;
    }

    if (first === "date") {
        addTerminalLine(
            new Date().toLocaleString(state.language),
            "terminal-success"
        );
        return;
    }

    if (first === "whoami") {
        addTerminalLine(
            terminalMessage(
                "user",
                "Kaan Yaşar · Administrator (demo UI)"
            ),
            "terminal-success"
        );
        return;
    }

    if (first === "modules") {
        addTerminalLine(
            ["Home", ...Object.keys(moduleDescriptions)]
                .map(getModuleLabel)
                .join(" · "),
            "terminal-success"
        );
        return;
    }

    if (first === "open") {
        const requested = parts.slice(1).join(" ").toLowerCase();

        const match = Object.keys(moduleTranslationKeys).find(name =>
            name.toLowerCase() === requested ||
            getModuleLabel(name).toLowerCase() === requested
        );

        if (requested === "home" || requested === "overview") {
            openHome();
            addTerminalLine(
                terminalMessage("openedOverview", "Opened Overview."),
                "terminal-success"
            );
        } else if (match) {
            if (match !== "Devices" && moduleTranslationKeys[match]) {
                window.location.assign(`/pages/${moduleTranslationKeys[match]}/`);
            } else {
                openModule(match);
            }
            addTerminalLine(
                `${terminalMessage("opened", "Opened")} ${getModuleLabel(match)}.`,
                "terminal-success"
            );
        } else {
            addTerminalLine(
                terminalMessage(
                    "moduleNotFound",
                    "Module not found. Type 'modules'."
                ),
                "terminal-error"
            );
        }

        return;
    }

    if (first === "get" && second === "status") {
        addTerminalLine(
            terminalMessage("checkingApi", "Checking Cartman API..."),
            "terminal-muted"
        );

        try {
            const response = await fetch("/api/health", {
                headers: { Accept: "application/json" }
            });

            if (!response.ok) throw new Error("API request failed");

            const data = await response.json();

            addTerminalLine(`Application: ${data.app}`, "terminal-success");
            addTerminalLine(`Status: ${data.status}`, "terminal-success");
        } catch {
            addTerminalLine(
                terminalMessage(
                    "apiUnavailable",
                    "API unavailable. Check the backend server."
                ),
                "terminal-error"
            );
        }

        return;
    }

    if (first === "get" && second === "devices") {
        const devices = getDeviceData();
        const online = devices.filter(device => device.status === "Online").length;
        const warning = devices.filter(device => device.status === "Warning").length;
        const offline = devices.filter(device => device.status === "Offline").length;

        addTerminalLine(
            `Demo inventory: ${devices.length} devices, ${online} online, ${warning} warning, ${offline} offline.`,
            "terminal-muted"
        );
        addTerminalLine(
            terminalMessage(
                "sampleData",
                "These are sample values, not live endpoint data."
            )
        );

        return;
    }

    if (first === "get" && second === "tickets") {
        addTerminalLine(
            terminalMessage(
                "demoTickets",
                "Demo ticket queue: 5 open, 3 in progress, 12 resolved."
            ),
            "terminal-muted"
        );
        addTerminalLine(
            terminalMessage(
                "ticketingOffline",
                "Ticketing backend is not connected."
            )
        );
        return;
    }

    addTerminalLine(
        terminalMessage(
            "unknownCommand",
            "Unknown command. Type 'help' for available commands."
        ),
        "terminal-error"
    );
}

/* =========================================================
   API STATUS
   ========================================================= */

async function checkApiStatus() {
    const status = $("#api-status");
    if (!status) return;

    status.textContent = translate("apiChecking", "Checking...");
    status.style.color = "";

    try {
        const response = await fetch("/api/health", {
            headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("API request failed");

        const data = await response.json();

        status.textContent = data.status === "online"
            ? translate("apiOnline", "Online")
            : data.status;

        status.style.color = data.status === "online"
            ? "var(--green)"
            : "var(--red)";
    } catch {
        status.textContent = translate("apiOffline", "Offline");
        status.style.color = "var(--red)";
    }
}

/* =========================================================
   INITIALIZATION
   ========================================================= */

async function initializeCartman() {
    try {
        applyTheme(localStorage.getItem("cartman-theme") || "dark");
    } catch {
        applyTheme("dark");
    }

    renderLanguageFlags();

    let savedLanguage = "en";

    try {
        savedLanguage = localStorage.getItem("cartman-language") || "en";
    } catch {
        // Use English if local storage is unavailable.
    }

    try {
        await applyLanguage(
            languageNames[savedLanguage] ? savedLanguage : "en",
            false
        );
    } catch (error) {
        console.error("Language initialization failed:", error);
    }

    await checkApiStatus();

    console.info("Cartman UI initialized.");
}

setupCartmanEvents();
void initializeCartman();


