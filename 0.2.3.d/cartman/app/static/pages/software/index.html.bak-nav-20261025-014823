<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b1020">
    <title>Cartman | Software</title>
    <link rel="stylesheet" href="/static/style.css">
    <script src="/static/js/modules/standalone-page.js" defer></script>
    <script src="/static/js/core/module-definitions.js" defer></script>
    <script src="/static/js/modules/standalone-navigation.js" defer></script>

    <style>
        .sw-page {
            width: 100%;
            max-width: 1750px;
            margin: auto;
            padding: 30px clamp(14px, 2.5vw, 36px);
        }
        .sw-hero {
            position: relative;
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 30px;
            overflow: hidden;
            border: 1px solid var(--border-color, #293247);
            border-radius: 18px;
            background:
                radial-gradient(ellipse at 90% 0%, #8b5cf62b, transparent 42%),
                linear-gradient(120deg, var(--card-bg, #111827), #10172a);
        }
        .sw-hero-icon {
            display: grid;
            flex: 0 0 58px;
            width: 58px;
            height: 58px;
            place-items: center;
            border: 1px solid #a78bfa50;
            border-radius: 16px;
            background: #8b5cf625;
            color: #c4b5fd;
            font-size: 29px;
        }
        .sw-eyebrow {
            color: #a5b4fc;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.6px;
        }
        .sw-hero h1 {
            margin: 7px 0;
            font-size: clamp(26px, 3vw, 35px);
            letter-spacing: -.8px;
        }
        .sw-hero p {
            max-width: 660px;
            margin: 0;
            color: var(--muted, #8b95a7);
            font-size: 13px;
            line-height: 1.7;
        }
        .sw-section { margin-top: 28px; }
        .sw-section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 15px;
        }
        .sw-section-heading h2 {
            margin: 0 0 5px;
            font-size: 19px;
        }
        .sw-section-heading p {
            margin: 0;
            color: var(--muted, #8b95a7);
            font-size: 12px;
        }
        .sw-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }
        .sw-stat {
            min-width: 0;
            padding: 19px;
            border: 1px solid var(--border-color, #293247);
            border-radius: 13px;
            background: var(--card-bg, #111827);
        }
        .sw-stat span {
            display: block;
            color: var(--muted, #8b95a7);
            font-size: 12px;
        }
        .sw-stat strong {
            display: block;
            margin: 12px 0 7px;
            font-size: 30px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
        }
        .sw-stat small {
            color: var(--muted, #8b95a7);
            font-size: 11px;
        }
        .sw-stat:nth-child(1) strong { color: #c4b5fd; }
        .sw-stat:nth-child(2) strong { color: #6ee7b7; }
        .sw-stat:nth-child(3) strong { color: #fcd34d; }
        .sw-stat:nth-child(4) strong { color: #93c5fd; }

        .sw-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }
        .sw-card {
            position: relative;
            display: flex;
            min-height: 205px;
            flex-direction: column;
            align-items: flex-start;
            padding: 22px;
            border: 1px solid var(--border-color, #293247);
            border-radius: 14px;
            background: var(--card-bg, #111827);
            color: inherit;
            text-decoration: none;
            transition: transform .18s ease, border-color .18s ease,
                        box-shadow .18s ease;
        }
        .sw-card:hover {
            transform: translateY(-3px);
            border-color: #818cf87a;
            box-shadow: 0 12px 30px #00000018;
        }
        .sw-card-icon {
            display: grid;
            width: 43px;
            height: 43px;
            place-items: center;
            margin-bottom: 19px;
            border: 1px solid #818cf83d;
            border-radius: 11px;
            background: #818cf81b;
            color: #c4b5fd;
            font-size: 21px;
        }
        .sw-card h3 { margin: 0 0 8px; font-size: 16px; }
        .sw-card p {
            margin: 0 0 20px;
            color: var(--muted, #8b95a7);
            font-size: 12px;
            line-height: 1.7;
        }
        .sw-card-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            width: 100%;
            margin-top: auto;
            padding-top: 13px;
            border-top: 1px solid var(--border-color, #293247);
            font-size: 11px;
            font-weight: 700;
        }
        .sw-card-foot b { color: #a5b4fc; font-size: 17px; }
        .sw-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--muted, #8b95a7);
            font-size: 11px;
        }
        .sw-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #64748b;
        }
        .sw-status[data-state="connected"]::before { background: #34d399; }
        .sw-status[data-state="error"]::before { background: #fb7185; }

        .sw-panel {
            overflow: hidden;
            border: 1px solid var(--border-color, #293247);
            border-radius: 14px;
            background: var(--card-bg, #111827);
        }
        .sw-panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 20px;
        }
        .sw-panel-head h2 { margin: 0 0 5px; font-size: 16px; }
        .sw-panel-head p {
            margin: 0;
            color: var(--muted, #8b95a7);
            font-size: 12px;
        }
        .sw-table-wrap { overflow: auto; }
        .sw-table {
            width: 100%;
            border-collapse: collapse;
            white-space: nowrap;
            font-size: 12px;
        }
        .sw-table th, .sw-table td {
            padding: 13px 16px;
            border-top: 1px solid var(--border-color, #293247);
            text-align: left;
        }
        .sw-table th {
            background: var(--panel-bg, #0b1020);
            color: var(--muted, #8b95a7);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }
        .sw-table td { color: var(--text-color, inherit); }
        .sw-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 20px;
            background: #64748b25;
            font-size: 10px;
            font-weight: 700;
        }
        .sw-badge[data-status="Active"] { color: #6ee7b7; background: #10b98120; }
        .sw-badge[data-status="Draft"] { color: #fcd34d; background: #f59e0b20; }
        .sw-badge[data-status="Deprecated"] { color: #fda4af; background: #f43f5e20; }
        .sw-empty {
            padding: 24px;
            color: var(--muted, #8b95a7);
            font-size: 12px;
            text-align: center;
        }
        .sw-link {
            color: #a5b4fc;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }
        .sw-link:hover { text-decoration: underline; }
        .sw-footer {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 28px;
            padding: 18px 0;
            border-top: 1px solid var(--border-color, #293247);
            color: var(--muted, #8b95a7);
            font-size: 11px;
        }
        @media (max-width: 950px) {
            .sw-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .sw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 600px) {
            .sw-page { padding: 18px 12px; }
            .sw-hero { align-items: flex-start; padding: 21px; }
            .sw-hero-icon { flex-basis: 43px; width: 43px; height: 43px; }
            .sw-stats, .sw-grid { grid-template-columns: 1fr; }
            .sw-card { min-height: 180px; }
            .sw-footer { flex-direction: column; }
        }
    </style>
</head>
<body>
<header class="topbar">
    <div class="brand-area">
        <a class="brand" href="/">
            <span class="brand-logo">C</span><span>CARTMAN</span>
        </a>
    </div>
    <div class="top-actions">
        <a class="secondary-button" href="/">&#8592; Dashboard</a>
    </div>
</header>

<main class="sw-page">
    <section class="sw-hero">
        <div class="sw-hero-icon" aria-hidden="true">&#9672;</div>
        <div>
            <div class="sw-eyebrow">CARTMAN WORKSPACE / SOFTWARE</div>
            <h1>Software Management</h1>
            <p>
                Manage software packages, review software inventory and
                organize deployment workflows from one workspace.
            </p>
        </div>
    </section>

    <section class="sw-section">
        <div class="sw-section-heading">
            <div>
                <h2>Catalog overview</h2>
                <p>Live statistics from the Cartman software catalog.</p>
            </div>
            <span class="sw-status" id="sw-api-status" data-state="loading">
                Connecting to API
            </span>
        </div>

        <div class="sw-stats">
            <article class="sw-stat">
                <span>Total packages</span>
                <strong id="sw-total">—</strong>
                <small>Registered catalog records</small>
            </article>
            <article class="sw-stat">
                <span>Active</span>
                <strong id="sw-active">—</strong>
                <small>Available catalog packages</small>
            </article>
            <article class="sw-stat">
                <span>Draft</span>
                <strong id="sw-draft">—</strong>
                <small>Packages pending review</small>
            </article>
            <article class="sw-stat">
                <span>Deprecated</span>
                <strong id="sw-deprecated">—</strong>
                <small>Retired catalog entries</small>
            </article>
        </div>
    </section>

    <section class="sw-section">
        <div class="sw-section-heading">
            <div>
                <h2>Software workspace</h2>
                <p>Choose the area you want to manage.</p>
            </div>
        </div>

        <div class="sw-grid">
            <a class="sw-card" href="/pages/software-catalog/">
                <span class="sw-card-icon">&#9638;</span>
                <h3>Software Catalog</h3>
                <p>
                    Maintain package metadata, publishers, versions,
                    operating system compatibility and installation details.
                </p>
                <span class="sw-card-foot">
                    <span>Manage packages</span><b>&rarr;</b>
                </span>
            </a>

            <a class="sw-card" href="/pages/software-inventory/">
                <span class="sw-card-icon">&#9783;</span>
                <h3>Software Inventory</h3>
                <p>
                    Review installed applications across managed devices.
                    Live installed-software collection still needs integration.
                </p>
                <span class="sw-card-foot">
                    <span>View inventory</span><b>&rarr;</b>
                </span>
            </a>

            <a class="sw-card" href="/pages/software-deployment/">
                <span class="sw-card-icon">&#8682;</span>
                <h3>Software Deployment</h3>
                <p>
                    Review rollout planning and deployment workflows.
                    Current deployment page remains a demo.
                </p>
                <span class="sw-card-foot">
                    <span>Open deployment</span><b>&rarr;</b>
                </span>
            </a>

            <a class="sw-card" href="/pages/deployment-jobs/">
                <span class="sw-card-icon">&#9776;</span>
                <h3>Deployment Jobs</h3>
                <p>Review queued jobs and follow the deployment workflow.</p>
                <span class="sw-card-foot">
                    <span>Review jobs</span><b>&rarr;</b>
                </span>
            </a>

            <a class="sw-card" href="/pages/deployment-history/">
                <span class="sw-card-icon">&#8634;</span>
                <h3>Deployment History</h3>
                <p>Open deployment history and review recorded outcomes.</p>
                <span class="sw-card-foot">
                    <span>View history</span><b>&rarr;</b>
                </span>
            </a>

            <a class="sw-card" href="/pages/patch-management/">
                <span class="sw-card-icon">&#10003;</span>
                <h3>Patch Management</h3>
                <p>Open the patch management workspace and review its current capabilities.</p>
                <span class="sw-card-foot">
                    <span>Open workspace</span><b>&rarr;</b>
                </span>
            </a>
        </div>
    </section>

    <section class="sw-section">
        <div class="sw-panel">
            <div class="sw-panel-head">
                <div>
                    <h2>Recently registered packages</h2>
                    <p>Latest entries returned by the software catalog API.</p>
                </div>
                <a class="sw-link" href="/pages/software-catalog/">Open catalog &#8599;</a>
            </div>
            <div class="sw-table-wrap">
                <table class="sw-table">
                    <thead>
                        <tr>
                            <th>Software</th>
                            <th>Publisher</th>
                            <th>Version</th>
                            <th>Target OS</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="sw-recent">
                        <tr><td colspan="5" class="sw-empty">Loading catalog records...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <footer class="sw-footer">
        <span>Cartman Infrastructure Management</span>
        <span>Catalog statistics are API-backed · Inventory and deployment integrations are not yet live</span>
    </footer>
</main>

<script>
"use strict";

(async function loadSoftwareOverview() {
    const $ = selector => document.querySelector(selector);
    const apiStatus = $("#sw-api-status");
    const recent = $("#sw-recent");

    function addCell(row, value) {
        const td = document.createElement("td");
        td.textContent = value || "—";
        row.appendChild(td);
        return td;
    }

    try {
        const response = await fetch("/api/software", {
            headers: { "Accept": "application/json" }
        });
        if (!response.ok) throw new Error("API returned HTTP " + response.status);

        const data = await response.json();
        if (!Array.isArray(data)) throw new Error("Unexpected catalog response");

        const counts = {
            total: data.length,
            active: data.filter(item => item.status === "Active").length,
            draft: data.filter(item => item.status === "Draft").length,
            deprecated: data.filter(item => item.status === "Deprecated").length
        };

        $("#sw-total").textContent = counts.total;
        $("#sw-active").textContent = counts.active;
        $("#sw-draft").textContent = counts.draft;
        $("#sw-deprecated").textContent = counts.deprecated;

        apiStatus.textContent = "Catalog API connected";
        apiStatus.dataset.state = "connected";

        recent.replaceChildren();
        const items = [...data].sort((a, b) =>
            String(b.updated_at || b.created_at || "")
                .localeCompare(String(a.updated_at || a.created_at || ""))
        ).slice(0, 5);

        if (!items.length) {
            const row = document.createElement("tr");
            const td = document.createElement("td");
            td.colSpan = 5;
            td.className = "sw-empty";
            td.textContent = "No packages registered yet. Add your first package in Software Catalog.";
            row.appendChild(td);
            recent.appendChild(row);
            return;
        }

        for (const item of items) {
            const row = document.createElement("tr");
            addCell(row, item.name);
            addCell(row, item.publisher);
            addCell(row, item.version);
            addCell(row, item.target_os);

            const statusCell = addCell(row, "");
            const badge = document.createElement("span");
            badge.className = "sw-badge";
            badge.dataset.status = item.status || "";
            badge.textContent = item.status || "Unknown";
            statusCell.appendChild(badge);
            recent.appendChild(row);
        }
    } catch (error) {
        apiStatus.textContent = "Catalog API unavailable";
        apiStatus.dataset.state = "error";
        recent.replaceChildren();

        const row = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5;
        td.className = "sw-empty";
        td.textContent = "Could not load catalog: " + error.message;
        row.appendChild(td);
        recent.appendChild(row);
    }
})();
</script>
</body>
</html>
