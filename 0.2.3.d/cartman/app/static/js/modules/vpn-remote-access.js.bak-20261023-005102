
(() => {
  "use strict";
  const root = document.querySelector("[data-vpn-page]");
  if (!root) return;
  const page = root.dataset.vpnPage;
  const $ = (s, r = root) => r.querySelector(s);
  const $$ = (s, r = root) => [...r.querySelectorAll(s)];
  const esc = value => String(value ?? "").replace(/[&<>"']/g, ch => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[ch]);
  const now = () => new Date().toLocaleString(undefined, {dateStyle:"medium",timeStyle:"short"});
  const statusClass = value => {
    const v = String(value || "").toLowerCase();
    if (/online|active|connected|allowed|success|enabled|healthy|approved/.test(v)) return "is-online";
    if (/pending|review|warning|degraded/.test(v)) return "is-pending";
    if (/offline|denied|blocked|failed|error/.test(v)) return "is-offline";
    return "is-neutral";
  };
  const pill = value => `<span class="vpn-status ${statusClass(value)}">${esc(value)}</span>`;
  const demo = {
    remote: [
      {id:"SES-2048",name:"j.smith",sub:"MacBook Pro · managed",source:"10.20.4.18",gateway:"eu-west-gw01",activity:"2 min ago",status:"Connected",detail:"Remote user session",extra:"MFA verified · Demo record"},
      {id:"SES-2047",name:"a.demir",sub:"Windows 11 · managed",source:"10.20.8.42",gateway:"tr-izmir-gw01",activity:"8 min ago",status:"Connected",detail:"Remote user session",extra:"Device compliant · Demo record"},
      {id:"SES-2046",name:"svc.support",sub:"Support workstation",source:"10.20.3.90",gateway:"eu-west-gw01",activity:"24 min ago",status:"Pending review",detail:"Session awaiting approval",extra:"Approval not connected to a real workflow"},
      {id:"SES-2045",name:"m.kaya",sub:"Linux workstation",source:"10.20.9.12",gateway:"tr-izmir-gw01",activity:"1 hour ago",status:"Disconnected",detail:"Previous session",extra:"No live session telemetry"}
    ],
    "vpn-overview": [
