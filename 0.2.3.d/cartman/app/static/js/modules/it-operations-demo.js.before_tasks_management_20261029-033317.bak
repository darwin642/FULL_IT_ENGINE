root.addEventListener("input",event=>{
 const target=event.target;
 if(target&&target.matches&&target.matches("[data-wm-history-search]"))wmFilterSortExecutionHistory();
});
root.addEventListener("change",event=>{
 const target=event.target;
 if(target&&target.matches&&target.matches("[data-wm-history-status],[data-wm-history-trigger],[data-wm-history-automation],[data-wm-history-sort]"))wmFilterSortExecutionHistory();
});
root.addEventListener("click",event=>{
 const opener=event.target&&event.target.closest?event.target.closest("[data-wm-open-execution]"):null;
 if(opener){event.preventDefault();event.stopPropagation();wmOpenExecutionDetails(opener.getAttribute("data-wm-open-execution"));return;}
 const row=event.target&&event.target.closest?event.target.closest("tr[data-wm-execution-row]"):null;
 if(row){wmOpenExecutionDetails(row.dataset.index);}
});
root.addEventListener("keydown",event=>{
 const row=event.target&&event.target.closest?event.target.closest("tr[data-wm-execution-row]"):null;
 if(row&&(event.key==="Enter"||event.key===" ")){event.preventDefault();wmOpenExecutionDetails(row.dataset.index);}
});


// CARTMAN_AUTOMATION_ACTION_CLARITY_V1: keep action help and its fields in sync.
root.addEventListener("change",event=>{
 const choice=event.target&&event.target.closest?event.target.closest("[data-automation-action]"):null;
 if(!choice)return;
 const form=choice.closest("[data-automation-form]");
 if(!form)return;
 const isPython=choice.value==="run_python";
 const taskFields=form.querySelector("[data-task-action-fields]");
 const scriptFields=form.querySelector("[data-python-action-fields]");
 if(taskFields)taskFields.style.display=isPython?"none":"block";
 if(scriptFields)scriptFields.style.display=isPython?"block":"none";
 const title=form.querySelector('[name="task_title"]');
 const script=form.querySelector('[name="script_file"]');
 if(title)title.required=!isPython;
 if(script)script.required=isPython;
 const copy=form.querySelector("[data-automation-action-copy]");
 if(copy)copy.textContent=isPython
  ?"Cartman runs your uploaded Python file on the Cartman server. Output, exit code and errors are recorded in Execution History. It does not run on the selected user's computer or group devices."
  :"Cartman creates a task in the Tasks board. The Owner field below assigns the work to a person; Cartman does not perform the task automatically.";
});

root.addEventListener("input",e=>{if(e.target.matches("[data-search]"))rerenderKeepSearch();});
root.addEventListener("change",e=>{
 const el=e.target;
 if(el.matches("[data-kb-status]")){knowledgeState.statusFilter=el.value;renderKnowledge();}
 if(el.matches("[data-kb-category]")){activeFilter=el.value;renderKnowledge();}
 if(el.matches("[data-task-status]")){
  if(slug==="tasks")void updateWorkItemStatus(el.dataset.taskStatus,el.value);
  else{const t=tasks.find(x=>x.id===el.dataset.taskStatus);if(t)t.status=el.value;renderTasks();}
 }
 if(el.matches("[data-automation-toggle]"))void toggleOperationAutomation(el.dataset.automationToggle,el.checked);
 if(el.matches("[data-automation-trigger]")){
  const interval=root.querySelector('[name="interval_minutes"]');
  if(interval)interval.disabled=el.value!=="interval";
 }
 if(el.matches("[data-workflow-toggle]")){const w=workflows.find(x=>x.id===el.dataset.workflowToggle);if(w)w.enabled=el.checked;renderWorkflows();}
 if(el.matches("[data-period]"))renderReports();
});

root.addEventListener("click",e=>{
 if(slug==="ticketing"){void handleTicketingClick(e);return;}
 if(slug==="tasks" && e.target.matches("[data-work-item-backdrop]")){workItemState.modal=false;workItemState.draft=null;renderTasks();return;}
 const f=e.target.closest("[data-filter]");
 if(f){activeFilter=f.dataset.filter;render();return;}
 const b=e.target.closest("[data-action]");if(!b)return;
 const action=b.dataset.action;
 if(slug==="tasks"){
  if(action==="work-tab"){
   const next=b.dataset.tab;
   if(["tasks","automations","history"].includes(next)){workMgmtState.tab=next;workMgmtState.notice="";renderTasks();}
  }else if(action==="new-task"){
   workMgmtState.taskModal=true;workMgmtState.taskDraft=null;workMgmtState.error="";renderTasks();
  }else if(action==="cancel-new-task"){
   workMgmtState.taskModal=false;workMgmtState.taskDraft=null;renderTasks();
  }else if(action==="new-automation"){
   if(!workMgmtState.canManage){workMgmtState.error="Only an administrator can create automation rules.";renderTasks();return;}
   workMgmtState.automationModal=true;workMgmtState.automationDraft=null;workMgmtState.error="";renderTasks();
  }else if(action==="cancel-new-automation"){
   workMgmtState.automationModal=false;workMgmtState.automationDraft=null;renderTasks();
  }else if(action==="dismiss-work-modal"&&e.target===b){
   workMgmtState.taskModal=false;workMgmtState.automationModal=false;workMgmtState.taskDraft=null;workMgmtState.automationDraft=null;renderTasks();
  }else if(action==="run-automation"){
   const id=b.parentElement.querySelector("[data-automation-id]")?.value;
   if(id&&window.confirm("Run this automation now? It may create an operational task."))void runOperationAutomation(id);
  }else if(action==="refresh-work-management"){
   workMgmtState.loaded=false;void loadWorkManagement(true);
  }
  return;
 }

  // CARTMAN_KB_NEW_ARTICLE_CLICK_GUARD_V1
  if (action === "new-article" &&
      document.querySelector(".io-kb-list-panel")) {
    e.preventDefault();

    if (!knowledgeState.canManage) {
      window.alert("Only Cartman administrators can create articles.");
      return;
    }

    knowledgeState.error = "";
    knowledgeState.editor = {
      mode: "create",
      article: null,
      draft: null
    };
    renderKnowledge();
    return;
  }

    if (slug === "knowledge") {
    if (action === "close-knowledge-editor") {
      knowledgeState.editor = null;
      knowledgeState.error = "";
      renderKnowledge();
      return;
    }

    if (action === "new-article") {
      if (knowledgeState.canManage) {
        knowledgeState.error = "";
        knowledgeState.editor = {mode: "create", article: null, draft: null};
        renderKnowledge();
      }
    } else if (action === "refresh-knowledge") {
      void loadKnowledgeArticles(true);
    } else if (action === "close-kb-editor") {
      knowledgeState.editor = null;
      knowledgeState.error = "";
      renderKnowledge();
    } else if (action === "read-article") {
      const key = b.dataset.id;
      if (key) window.location.assign(`/pages/knowledge/article/${encodeURIComponent(key)}/`);
    } else if (action === "edit-article") {
      if (knowledgeState.canManage) {
        const article = knowledgeState.items.find(item => item.article_key === b.dataset.id);
        if (article) {
          knowledgeState.error = "";
          knowledgeState.editor = {mode: "edit", article, draft: null};
          renderKnowledge();
        }
      }
    } else if (action === "set-knowledge-status") {
      if (knowledgeState.canManage && ["Published", "Archived"].includes(b.dataset.status)) {
        void setKnowledgeArticleStatus(b.dataset.id, b.dataset.status);
      }
    } else if (action === "delete-article") {
      void deleteKnowledgeArticle(b.dataset.id);
    } else if (action === "draft-knowledge-article") {
      const reason = window.prompt("Why is this article being moved to Draft? A reason is required.");
      if (reason !== null) {
        if (!reason.trim()) {
          window.alert("Please enter a reason before drafting this article.");
        } else {
          void changeKnowledgeArticleStatus(b.dataset.id, "Draft", reason.trim());
        }
      }
    } else if (action === "publish-knowledge-article") {
      void changeKnowledgeArticleStatus(b.dataset.id, "Published");
    } else if (action === "archive-knowledge-article") {
      const confirmed = window.confirm("Archive this article? It will no longer appear in the active Knowledge Base.");
      if (confirmed) void changeKnowledgeArticleStatus(b.dataset.id, "Archived");
    }
    return;
  }
 if(action==="ticket-detail"){const t=tickets.find(x=>x.id===b.dataset.id);if(t)alert(`${t.id} — ${t.title}\n\n${t.desc}\n\nOwner: ${t.owner}\nStatus: ${t.status}\nSLA remaining: ${t.sla}`);}
 if(action==="new-ticket"){const title=prompt("Ticket title:");if(title&&title.trim()){tickets.unshift({id:"INC-"+(1049+tickets.length),title:title.trim(),type:"Incident",priority:"Normal",status:"Open",owner:"Unassigned",team:"Service Desk",time:"Just now",desc:"Created in local demo.",sla:"4 hours"});activeFilter="All";renderTicketing();}}
 if(action==="read-article"){const a=articles.find(x=>x.id===b.dataset.id);if(a)alert(`${a.title}\n\n${a.desc}\n\n${a.steps.map((x,i)=>`${i+1}. ${x}`).join("\n")}`);}
 if(action==="new-article"){const title=prompt("Article title:");if(title&&title.trim()){articles.unshift({id:"KB-"+String(articles.length+1).padStart(3,"0"),cat:"General",title:title.trim(),desc:"New local demo article. Edit this content in the demo workflow.",time:"2 min read",tag:"New",steps:["Define the symptom.","Collect relevant logs.","Validate the fix.","Document the result."]});activeFilter="All";renderKnowledge();}}
 if(action==="new-task" && slug==="tasks"){workItemState.modal=true;workItemState.error="";workItemState.draft=null;renderTasks();}
 if(action==="cancel-new-task" && slug==="tasks"){workItemState.modal=false;workItemState.draft=null;renderTasks();}
 if(action==="retry-work-items" && slug==="tasks"){workItemState.loaded=false;void loadWorkItems(true);}
 if(action==="new-workflow"){const name=prompt("Workflow name:");if(name&&name.trim()){workflows.push({id:"WF-"+String(workflows.length+1).padStart(3,"0"),name:name.trim(),trigger:"Manual trigger",condition:"No conditions configured",action:"Review required",runs:0,success:100,enabled:false});renderWorkflows();}}
 if(action==="simulate"){const card=b.closest(".io-workflow");const id=card?.querySelector("[data-workflow-id]")?.value;const w=workflows.find(x=>x.id===id);if(w)alert(w.enabled?`Demo simulation complete: ${w.name}\n\nNo external actions were executed.`:`${w.name} is disabled. Enable it before simulating a run.`);}
 if(action==="read-all"){notices.forEach(n=>n.read=true);renderNotifications();}
 if(action==="toggle-read"){const id=Number(b.parentElement.querySelector("[data-notice-id]")?.value);const n=notices.find(x=>x.id===id);if(n)n.read=!n.read;renderNotifications();}
 if(action==="export-csv"){const csv=[["Metric","Value","Note"],["Tickets resolved","184","Illustrative demo value"],["SLA attainment","96.4%","Illustrative demo value"],["Mean resolution","3h 42m","Illustrative demo value"],["Backlog change","-12.8%","Illustrative demo value"],["Reporting window",($("[data-period]")?.value||"7")+" days","Selected period"]].map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(",")).join("\r\n");const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8;"});const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download="cartman-operations-demo-report.csv";a.click();URL.revokeObjectURL(url);}
});

// CARTMAN_TASK_PRIMARY_ACTION_CAPTURE_V1
// Narrow fallback for task tabs and the New Task button only.
document.addEventListener("click", event => {
    const button = event.target && event.target.closest
        ? event.target.closest('[data-action="work-tab"], [data-action="new-task"]')
        : null;

    if (!button) return;

    const activeRoot = document.querySelector(".workspace-module");
    if (
        !activeRoot ||
        !activeRoot.contains(button) ||
        !activeRoot.querySelector(".wm-tabs")
    ) return;

    if (workMgmtState.currentUser?.role !== "admin") return;

    event.preventDefault();
    event.stopPropagation();

    if (button.dataset.action === "work-tab") {
        const next = button.dataset.tab;
        if (!["tasks", "automations", "history"].includes(next)) return;

        workMgmtState.tab = next;
        workMgmtState.notice = "";
        renderTasks();
        return;
    }

    if (button.dataset.action === "new-task") {
        workMgmtState.taskModal = true;
        workMgmtState.taskDraft = null;
        workMgmtState.error = "";
        renderTasks();
    }
}, true);

// CARTMAN_TASK_COMPLETION_MODAL_V1
root.addEventListener("click", event => {
 const clicked=event.target&&event.target.closest?event.target:null;
 if(!clicked||slug!=="tasks")return;
 const completeButton=clicked.closest('[data-action="complete-work-item"]');
 if(completeButton){
  event.preventDefault();event.stopPropagation();event.stopImmediatePropagation();
  const taskKey=String(completeButton.dataset.taskKey||"");
  const item=Array.isArray(tasks)?tasks.find(t=>String(t.task_key||t.id||"")===taskKey):null;
  if(!taskKey||(!workMgmtState.canManage&&!item?.can_complete)){
   workMgmtState.completionError="You are not allowed to complete this task.";
   renderTasks();
   return;
  }
  workMgmtState.completionModal={taskKey,title:String(item?.title||taskKey),description:""};
  workMgmtState.completionSaving=false;
  workMgmtState.completionError="";
  renderTasks();
  return;
 }
 const cancel=clicked.closest("[data-work-item-completion-cancel]");
 const backdrop=clicked.matches("[data-work-item-completion-backdrop]");
 if(cancel||backdrop){
  event.preventDefault();event.stopPropagation();event.stopImmediatePropagation();
  if(workMgmtState.completionSaving)return;
  workMgmtState.completionModal=null;
  workMgmtState.completionError="";
  renderTasks();
 }
}, true);

root.addEventListener("submit", event => {
 const form=event.target&&event.target.closest?event.target.closest("[data-work-item-completion-form]"):null;
 if(!form||slug!=="tasks")return;
 event.preventDefault();event.stopPropagation();event.stopImmediatePropagation();
 if(workMgmtState.completionSaving)return;
 const formData=new FormData(form);
 const description=String(formData.get("completion_description")||"").trim();
 const taskKey=String(form.dataset.taskKey||workMgmtState.completionModal?.taskKey||"");
 if(description.length<3||description.length>3000){
  workMgmtState.completionError="Describe your actions in 3–3000 characters.";
  if(workMgmtState.completionModal)workMgmtState.completionModal.description=description;
  renderTasks();
  return;
 }
 if(!taskKey){workMgmtState.completionError="The task identifier is missing.";renderTasks();return;}
 if(workMgmtState.completionModal)workMgmtState.completionModal.description=description;
 workMgmtState.completionSaving=true;
 workMgmtState.completionError="";
 renderTasks();
 void (async()=>{
  try{
   await ticketApi(`/api/work-items/${encodeURIComponent(taskKey)}/complete`,{
    method:"POST",
    body:{completion_description:description}
   });
   workMgmtState.completionModal=null;
   workMgmtState.completionSaving=false;
   workMgmtState.completionError="";
   workMgmtState.notice=`Completed ${taskKey}; the completion notes were saved.`;
   workMgmtState.error="";
   await loadWorkManagement(true);
  }catch(error){
   workMgmtState.completionSaving=false;
   workMgmtState.completionError=error.message||"Could not complete the task.";
   if(workMgmtState.completionModal)workMgmtState.completionModal.description=description;
   renderTasks();
  }
 })();
}, true);

render();
})();

// CARTMAN_WORK_MANAGEMENT_LIST_LAYOUT_V2
document.querySelector(".workspace-module")?.addEventListener("click",event=>{
 const taskClose=event.target&&event.target.closest?event.target.closest("[data-wm-task-close]"):null;
 const automationClose=event.target&&event.target.closest?event.target.closest("[data-wm-automation-close]"):null;
 const taskButton=event.target&&event.target.closest?event.target.closest("[data-wm-task-open]"):null;
 const automationButton=event.target&&event.target.closest?event.target.closest("[data-wm-automation-open]"):null;
 if(taskClose||automationClose||taskButton||automationButton){
  event.preventDefault();
  // Do not allow the legacy delegated click router or browser scroll anchoring to move the page.
  event.stopPropagation();
  const button=taskButton||automationButton;
  const card=button?button.closest(taskButton?"[data-wm-task-card]":"[data-wm-automation-item]"):(taskClose?taskClose.closest("[data-wm-task-card]"):automationClose.closest("[data-wm-automation-item]"));
  const detail=card&&card.querySelector(taskButton?"[data-wm-task-detail]":automationButton?"[data-wm-automation-detail]":taskClose?"[data-wm-task-detail]":"[data-wm-automation-detail]");
  if(!card||!detail)return;
  const scrollBox=card.closest(".wm-task-list-scroll,.wm-automation-list-scroll");
  const savedInner=scrollBox?scrollBox.scrollTop:0;
  const savedOuter=window.scrollY;
  if(taskClose||automationClose){detail.hidden=true;const openers=card.querySelectorAll("[data-wm-task-open],[data-wm-automation-open]");openers.forEach(el=>el.setAttribute("aria-expanded","false"));}
  else {
   const opening=detail.hidden;
   const selector=taskButton?"[data-wm-task-card]":"[data-wm-automation-item]";
   const detailSelector=taskButton?"[data-wm-task-detail]":"[data-wm-automation-detail]";
   const openerSelector=taskButton?"[data-wm-task-open]":"[data-wm-automation-open]";
   const section=card.closest(taskButton?"[data-wm-task-panel]":"[data-wm-automation-panel]");
   if(section)section.querySelectorAll(selector).forEach(other=>{const d=other.querySelector(detailSelector);if(d)d.hidden=true;other.querySelectorAll(openerSelector).forEach(o=>o.setAttribute("aria-expanded","false"));});
   detail.hidden=!opening;
   if(opening)card.querySelectorAll(openerSelector).forEach(el=>el.setAttribute("aria-expanded","true"));
  }
  const isNowOpen=!detail.hidden;
  requestAnimationFrame(()=>{
   window.scrollTo(0,savedOuter);
   if(scrollBox){
    if(isNowOpen){
     const detailRect=detail.getBoundingClientRect(),boxRect=scrollBox.getBoundingClientRect();
     if(detailRect.bottom>boxRect.bottom)scrollBox.scrollTop+=detailRect.bottom-boxRect.bottom+12;
     else if(detailRect.top<boxRect.top)scrollBox.scrollTop-=boxRect.top-detailRect.top+12;
    }else{scrollBox.scrollTop=savedInner;}
   }
  });
 }
});

// CARTMAN_WORK_MANAGEMENT_LIST_LAYOUT_V2
