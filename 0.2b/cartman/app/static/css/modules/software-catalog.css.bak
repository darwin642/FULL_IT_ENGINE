/* Software Catalog */
.sc-page { width:100%; max-width:1800px; margin:0 auto; padding:28px 24px; }
.sc-header { margin-bottom:24px; }
.sc-workspace { display:flex; flex-direction:column; gap:18px; min-width:0; }
.sc-toolbar { display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap; }
.sc-toolbar-copy h2 { margin:5px 0; font-size:23px; }
.sc-toolbar-copy p,.sc-panel-heading p { margin:0; color:var(--muted,#8b95a7); font-size:13px; }
.sc-eyebrow { display:block; color:var(--muted,#8b95a7); font-size:10px; font-weight:800; letter-spacing:1.3px; }
.sc-toolbar-actions { display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
.sc-toolbar-actions button,.sc-modal-footer button { cursor:pointer; }
.sc-message { min-height:18px; font-size:12px; color:var(--muted,#8b95a7); }
.sc-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
.sc-stat { display:flex; flex-direction:column; gap:8px; padding:19px 20px; border:1px solid var(--border,#293247); border-radius:12px; background:var(--surface,#111827); }
.sc-stat span { font-size:12px; color:var(--muted,#8b95a7); }
.sc-stat strong { font-size:29px; line-height:1.1; }
.sc-stat small { font-size:11px; color:var(--muted,#8b95a7); }
.sc-panel { min-width:0; border:1px solid var(--border,#293247); border-radius:12px; background:var(--surface,#111827); overflow:hidden; }
.sc-panel-heading { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:20px 20px 16px; }
.sc-panel-heading h2 { margin:0 0 6px; font-size:17px; }
.sc-count { padding:6px 9px; border:1px solid var(--border,#293247); border-radius:7px; color:var(--muted,#8b95a7); font-size:11px; white-space:nowrap; }
.sc-filters { display:flex; gap:10px; padding:0 20px 16px; }
.sc-search { display:flex; align-items:center; gap:9px; flex:1; min-width:180px; padding:0 12px; border:1px solid var(--border,#293247); border-radius:8px; }
.sc-search span { font-size:21px; color:var(--muted,#8b95a7); }
.sc-search input { width:100%; min-width:0; padding:11px 0; border:0; outline:0; background:transparent; color:var(--text,#e5e7eb); font:inherit; font-size:12px; }
.sc-filters select,.sc-field input,.sc-field select,.sc-field textarea,.sc-operator input { min-width:0; border:1px solid var(--border,#293247); border-radius:8px; background:var(--surface-2,#0b1020); color:var(--text,#e5e7eb); font:inherit; font-size:12px; }
.sc-filters select { padding:0 12px; }
.sc-table-wrap { width:100%; overflow:auto; }
.sc-table { width:100%; border-collapse:collapse; white-space:nowrap; font-size:12px; }
.sc-table th,.sc-table td { padding:13px 14px; text-align:left; border-top:1px solid var(--border,#293247); }
.sc-table th { color:var(--muted,#8b95a7); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.55px; background:var(--surface-2,#0b1020); }
.sc-table td { color:var(--text,#e5e7eb); }
.sc-table tbody tr:hover { background:var(--surface-2,#0b1020); }
.software-status { display:inline-flex; padding:4px 8px; border-radius:999px; background:#64748b22; color:var(--text,#e5e7eb); font-size:10px; font-weight:700; }
.software-status[data-status="Active"] { background:#16a34a20; color:#4ade80; }
.software-status[data-status="Draft"] { background:#d9770620; color:#fbbf24; }
.software-actions { display:flex; gap:6px; }
.software-action { padding:6px 8px; border:1px solid var(--border,#293247); border-radius:6px; background:transparent; color:var(--text,#e5e7eb); font:inherit; font-size:11px; cursor:pointer; }
.software-action:hover { background:var(--surface-2,#0b1020); }
.sc-empty { padding:22px; text-align:center; color:var(--muted,#8b95a7); font-size:12px; }
.sc-operator { display:flex; align-items:center; gap:12px; flex-wrap:wrap; color:var(--muted,#8b95a7); font-size:11px; }
.sc-operator label { font-weight:700; color:var(--text,#e5e7eb); }
.sc-operator input { padding:8px 10px; }
.sc-operator span { flex-basis:100%; }
.sc-backdrop { position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; padding:20px; background:#020617b8; overflow-y:auto; }
.sc-backdrop[hidden] { display:none !important; }
.sc-modal { width:min(760px,100%); max-height:calc(100vh - 40px); display:flex; flex-direction:column; border:1px solid var(--border,#293247); border-radius:14px; background:var(--surface,#111827); box-shadow:0 24px 80px #0007; overflow:hidden; }
.sc-modal-header { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; padding:22px 24px; border-bottom:1px solid var(--border,#293247); }
.sc-modal-header h2 { margin:6px 0; font-size:21px; }
.sc-modal-header p { margin:0; color:var(--muted,#8b95a7); font-size:12px; }
.sc-icon-button { width:32px; height:32px; border:1px solid var(--border,#293247); border-radius:8px; background:transparent; color:var(--text,#e5e7eb); font-size:23px; cursor:pointer; }
.sc-form-body { padding:22px 24px; overflow:auto; }
.sc-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
.sc-field { display:flex; flex-direction:column; gap:7px; font-size:11px; font-weight:700; color:var(--muted,#8b95a7); }
.sc-field-wide { grid-column:1/-1; }
.sc-field input,.sc-field select,.sc-field textarea { width:100%; padding:10px 11px; font-weight:400; outline:none; }
.sc-field textarea { resize:vertical; }
.sc-field input:focus,.sc-field select:focus,.sc-field textarea:focus,.sc-operator input:focus,.sc-filters select:focus { border-color:var(--accent,#818cf8); }
.sc-form-error { color:#fca5a5; font-size:12px; white-space:pre-wrap; }
.sc-modal-footer { display:flex; justify-content:flex-end; gap:9px; padding:16px 24px; border-top:1px solid var(--border,#293247); }
.sc-history-modal { width:min(1100px,100%); }
.sc-history-content { padding:20px 24px; overflow:auto; color:var(--text,#e5e7eb); font-size:12px; }
.software-history-table { width:100%; border-collapse:collapse; }
.software-history-table th,.software-history-table td { padding:10px; border-bottom:1px solid var(--border,#293247); text-align:left; vertical-align:top; }
.software-history-table th { color:var(--muted,#8b95a7); font-size:10px; text-transform:uppercase; }
.software-history-details { min-width:220px; white-space:pre-wrap; overflow-wrap:anywhere; }
@media(max-width:760px) {
    .sc-page { padding:20px 12px; }
    .sc-stats { grid-template-columns:1fr; }
    .sc-toolbar { align-items:flex-start; }
    .sc-toolbar-actions { width:100%; }
    .sc-toolbar-actions button { flex:1; }
    .sc-filters { flex-direction:column; padding-inline:12px; }
    .sc-filters select { min-height:38px; }
    .sc-panel-heading { padding-inline:12px; }
    .sc-form-grid { grid-template-columns:1fr; }
    .sc-field-wide { grid-column:auto; }
    .sc-modal-header,.sc-form-body { padding:18px; }
    .sc-modal-footer { padding:14px 18px; }
}
