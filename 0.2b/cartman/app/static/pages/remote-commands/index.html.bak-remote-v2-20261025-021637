<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1020">
    <title>Cartman | Remote Commands</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/css/modules/remote-commands.css">
    <script src="/static/js/modules/standalone-page.js" defer></script>
    <script src="/static/js/core/module-definitions.js" defer></script>
    <script src="/static/js/modules/standalone-navigation.js" defer></script>
    <script src="/static/js/modules/remote-commands.js" defer></script>
</head>
<body>
<header class="topbar">
    <div class="brand-area">
        <a class="brand" href="/">
            <span class="brand-logo">C</span><span>CARTMAN</span>
        </a>
    </div>
    <div class="top-actions">
        <a class="secondary-button" href="/">&#8592; Dashboard</a>
    </div>
</header>

<main class="rc-page">
    <div class="module-header rc-module-header">
        <span class="category-icon purple">&#9000;</span>
        <div>
            <div class="eyebrow">CARTMAN WORKSPACE / ENDPOINT MANAGEMENT</div>
            <h1>Remote Commands</h1>
            <p>Review command activity, prepare commands and inspect execution results.</p>
        </div>
    </div>

    <section class="rc-notice" aria-label="Execution status">
        <span class="rc-notice-icon">&#9888;</span>
        <div>
            <strong data-rc-service-title>Checking agent connection...</strong>
            <p data-rc-service-description>Checking the local task service.</p>
        </div>
        <span class="rc-status-pill" data-rc-service-pill><i></i> Checking</span>
    </section>

    <div class="rc-section-heading">
        <div>
            <span class="rc-kicker">COMMAND OPERATIONS</span>
            <h2>Execution overview</h2>
        </div>
        <span class="rc-preview-tag" data-rc-preview-status>Loading task history...</span>
    </div>

    <section class="rc-stats" aria-label="Command statistics">
        <article class="rc-stat-card">
            <div class="rc-stat-top"><span>Total executions</span><span class="rc-stat-icon">&#9776;</span></div>
            <strong id="rc-stat-total">—</strong><small>Stored task records</small>
        </article>
        <article class="rc-stat-card">
            <div class="rc-stat-top"><span>Completed</span><span class="rc-stat-icon rc-green">&#10003;</span></div>
            <strong id="rc-stat-completed">—</strong><small>Successfully completed</small>
        </article>
        <article class="rc-stat-card">
            <div class="rc-stat-top"><span>Pending</span><span class="rc-stat-icon rc-amber">&#9711;</span></div>
            <strong id="rc-stat-pending">—</strong><small>Queued or running</small>
        </article>
        <article class="rc-stat-card">
            <div class="rc-stat-top"><span>Failed</span><span class="rc-stat-icon rc-red">!</span></div>
            <strong id="rc-stat-failed">—</strong><small>Failed executions</small>
        </article>
    </section>

    <section class="rc-layout">
        <div class="rc-main-column">
            <section class="rc-panel rc-history-panel">
                <div class="rc-panel-heading">
                    <div>
                        <span class="rc-kicker">ACTIVITY</span>
                        <h2>Command history</h2>
                        <p>Review past executions and their results.</p>
                    </div>
                    <div class="rc-heading-actions"><span class="rc-count" data-rc-count>0 records</span><button type="button" class="rc-button rc-button-secondary" data-rc-refresh>Refresh</button></div>
                </div>

                <div class="rc-filterbar">
                    <label class="rc-search-wrap">
                        <span>&#9906;</span>
                        <input type="search" data-rc-search placeholder="Search commands, targets..." aria-label="Search command history">
                    </label>
                    <select data-rc-status aria-label="Filter by execution status">
                        <option value="">All statuses</option>
                        <option value="completed">Completed</option>
                        <option value="pending">Pending</option>
                        <option value="failed">Failed</option>
                        <option value="running">Running</option>
                    </select>
                    <select data-rc-os aria-label="Filter by operating system">
                        <option value="">All platforms</option>
                        <option value="windows">Windows</option>
                        <option value="linux">Linux</option>
                        <option value="macos">macOS</option>
                    </select>
                </div>

                <div class="rc-table-wrap">
                    <table class="rc-table">
                        <thead>
                            <tr>
                                <th>COMMAND</th>
                                <th>TARGET</th>
                                <th>PLATFORM</th>
                                <th>STARTED</th>
                                <th>DURATION</th>
                                <th>STATUS</th>
                            </tr>
                        </thead>
                        <tbody data-rc-rows></tbody>
                    </table>
                    <div class="rc-empty-state" data-rc-empty>
                        <span class="rc-empty-icon">&#9000;</span>
                        <h3>No command executions yet</h3>
                        <p>Execution history will appear here when a command service is connected.</p>
                    </div>
                </div>
                <div class="rc-table-footer">
                    <span>Execution history</span>
                    <span data-rc-footer-count>0 records</span>
                </div>
            </section>

            <section class="rc-panel rc-detail-panel">
                <div class="rc-panel-heading">
                    <div>
                        <span class="rc-kicker">INSPECTION</span>
                        <h2>Execution details</h2>
                        <p>Command output and execution metadata.</p>
                    </div>
                    <span class="rc-neutral-pill">No selection</span>
                </div>
                <div class="rc-detail-empty">
                    <span class="rc-detail-icon">&#9776;</span>
                    <div>
                        <strong>No execution selected</strong>
                        <p>Select a command history record to review its details and output.</p>
                    </div>
                </div>
                <div class="rc-output-placeholder">
                    <div><span class="rc-terminal-dot"></span><span class="rc-terminal-dot"></span><span class="rc-terminal-dot"></span><span>COMMAND OUTPUT</span></div>
                    <pre>Waiting for an execution record...</pre>
                </div>
            </section>
        </div>

        <aside class="rc-panel rc-composer">
            <div class="rc-panel-heading">
                <div>
                    <span class="rc-kicker">COMMAND WORKSPACE</span>
                    <h2>Command composer</h2>
                    <p>Prepare a command for review.</p>
                </div>
                <span class="rc-composer-icon">&#9000;</span>
            </div>

            <div class="rc-form-field">
                <label for="rc-template">Remote action</label>
                <select id="rc-template" data-rc-template>
                    <option value="">Choose a template...</option>
                    <option value="self_test">Agent connection self-test</option>
                    <option value="shutdown">Shut down device</option>
                </select>
                <small>Only actions supported by the installed CartmanClient are available.</small>
            </div>

            <div class="rc-form-field">
                <label for="rc-target">Target device</label>
                <select id="rc-target">
                    <option>No endpoint inventory connected</option>
                </select>
            </div>

            <div class="rc-form-field">
                <label for="rc-command">Action details</label>
                <textarea id="rc-command" data-rc-command rows="4" spellcheck="false" readonly placeholder="Choose a supported action..."></textarea>
                <div class="rc-editor-footer"><span>Plain text preview</span><span data-rc-char-count>0 characters</span></div>
            </div>

            <div class="rc-security-note">
                <span>&#128274;</span>
                <div><strong>Controlled execution</strong><p>Tasks require an approved, connected CartmanClient with task execution enabled. Arbitrary shell commands are not supported by this interface.</p></div>
            </div>

            <div class="rc-composer-actions">
                <button type="button" class="rc-button rc-button-secondary" data-rc-clear>Clear</button>
            </div>
            <button type="button" class="rc-button rc-button-execute" data-rc-run disabled>Queue task <span>&#8594;</span></button>
            <p class="rc-copy-feedback" data-rc-feedback role="status" aria-live="polite"></p>
        </aside>
    </section>

    <footer class="app-footer rc-footer">
        <span>Cartman Infrastructure Management</span>
        <span>Approved CartmanClient task queue</span>
    </footer>
</main>
</body>
</html>
