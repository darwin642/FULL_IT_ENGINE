    <main class="main-content">
        <div class="breadcrumb">
            <span>Cartman</span>
            <span>/</span>
            <strong id="breadcrumb-page">Overview</strong>
        </div>

        <section id="home-view">
            <div class="welcome">
                <div class="eyebrow"><span class="eyebrow-dot"></span> INFRASTRUCTURE CONTROL CENTER</div>
                <h1>Welcome back, Kaan <span class="wave">✦</span></h1>
                <p>Manage your endpoints, infrastructure and operations from one place.</p>
            </div>

            <div class="section-heading">
                <div>
                    <h2>Environment overview</h2>
                    <p>A quick look at your workspace.</p>
                </div>
                <button id="refresh-dashboard" class="secondary-button">↻ Refresh</button>
            </div>

            <div class="stats-grid">
                <article class="stat-card stat-blue">
                    <div class="stat-top"><span>Managed devices</span><span class="stat-icon">▣</span></div>
                    <div class="stat-value">24</div>
                    <div class="stat-foot"><span class="stat-positive">↗ 3</span> this week</div>
                    <div class="stat-progress"><span style="width:75%"></span></div>
                </article>

                <article class="stat-card stat-green">
                    <div class="stat-top"><span>Healthy endpoints</span><span class="stat-icon">✓</span></div>
                    <div class="stat-value">21 <small>/ 24</small></div>
                    <div class="stat-foot"><span class="stat-positive">87.5%</span> health status</div>
                    <div class="stat-progress"><span style="width:87.5%"></span></div>
                </article>

                <article class="stat-card stat-orange">
                    <div class="stat-top"><span>Open tickets</span><span class="stat-icon">▤</span></div>
                    <div class="stat-value">05</div>
                    <div class="stat-foot"><span class="stat-warning">2 high priority</span></div>
                    <div class="stat-progress"><span style="width:38%"></span></div>
                </article>

                <article class="stat-card stat-purple">
                    <div class="stat-top"><span>Active tasks</span><span class="stat-icon">⌘</span></div>
                    <div class="stat-value">08</div>
                    <div class="stat-foot"><span class="stat-positive">6 completed</span> today</div>
                    <div class="stat-progress"><span style="width:65%"></span></div>
                </article>
            </div>

            <div class="dashboard-grid">
                <section class="panel">
                    <div class="panel-heading">
                        <div><h2>Device health</h2><p>Sample endpoint status</p></div>
                        <button class="text-button" data-page="Devices">View devices ↗</button>
                    </div>

                    <div class="health-summary">
                        <div class="health-ring">
                            <div><strong>87%</strong><small>Healthy</small></div>
                        </div>
                        <div class="health-legend">
                            <div><span class="legend-dot green-dot"></span><span>Healthy</span><strong>21</strong></div>
                            <div><span class="legend-dot orange-dot"></span><span>Warning</span><strong>2</strong></div>
                            <div><span class="legend-dot red-dot"></span><span>Offline</span><strong>1</strong></div>
                        </div>
                    </div>

                    <div class="device-list">
                        <div class="device-row">
                            <span class="device-symbol blue">W</span>
                            <div class="device-info"><strong>WS-ACCT-014</strong><small>Windows 11 · 10.0.0.14</small></div>
                            <span class="status-pill healthy">Healthy</span>
                        </div>
                        <div class="device-row">
                            <span class="device-symbol purple">L</span>
                            <div class="device-info"><strong>LINUX-WEB-02</strong><small>Ubuntu 24.04 · 10.0.1.22</small></div>
                            <span class="status-pill warning-pill">Warning</span>
                        </div>
                        <div class="device-row">
                            <span class="device-symbol cyan">M</span>
                            <div class="device-info"><strong>MAC-DESIGN-03</strong><small>macOS · 10.0.0.31</small></div>
                            <span class="status-pill healthy">Healthy</span>
                        </div>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-heading">
                        <div><h2>Ticket overview</h2><p>Sample support queue</p></div>
                        <button class="text-button" data-page="Ticketing">View tickets ↗</button>
                    </div>

                    <div class="ticket-summary">
                        <div><strong>05</strong><span>Open</span></div>
                        <div><strong>03</strong><span>In progress</span></div>
                        <div><strong>12</strong><span>Resolved</span></div>
                    </div>

                    <div class="ticket-list">
                        <div class="ticket-row">
                            <span class="priority-dot priority-high"></span>
                            <div><strong>#CT-1042 · VPN connectivity</strong><small>Network · 18 min ago</small></div>
                            <span class="status-pill warning-pill">Open</span>
                        </div>
                        <div class="ticket-row">
                            <span class="priority-dot priority-medium"></span>
                            <div><strong>#CT-1041 · Disk usage alert</strong><small>Infrastructure · 42 min ago</small></div>
                            <span class="status-pill progress-pill">In progress</span>
                        </div>
                        <div class="ticket-row">
                            <span class="priority-dot priority-low"></span>
                            <div><strong>#CT-1039 · Software request</strong><small>Endpoint · 2 hours ago</small></div>
                            <span class="status-pill healthy">Resolved</span>
                        </div>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-heading">
                        <div><h2>Recent activity</h2><p>Example workspace events</p></div>
                        <button class="text-button" data-page="Audit Logs">Audit logs ↗</button>
                    </div>

                    <div class="activity-list">
                        <div class="activity-item">
                            <span class="activity-icon activity-green">✓</span>
                            <div><strong>Health check completed</strong><p>Scheduled endpoint check finished.</p><small>5 minutes ago</small></div>
                        </div>
                        <div class="activity-item">
                            <span class="activity-icon activity-blue">↻</span>
                            <div><strong>Inventory sync preview</strong><p>Sample inventory data refreshed.</p><small>22 minutes ago</small></div>
                        </div>
                        <div class="activity-item">
                            <span class="activity-icon activity-orange">!</span>
                            <div><strong>New ticket recorded</strong><p>VPN connectivity issue · CT-1042.</p><small>18 minutes ago</small></div>
                        </div>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-heading">
                        <div><h2>Quick access</h2><p>Jump into a module</p></div>
                    </div>

                    <div class="quick-grid">
                        <button class="quick-item" data-page="Devices"><span class="quick-icon blue">▣</span><span><strong>Devices</strong><small>Endpoint list</small></span><b>↗</b></button>
                        <button class="quick-item" data-page="Monitoring"><span class="quick-icon green">◉</span><span><strong>Monitoring</strong><small>Health &amp; alerts</small></span><b>↗</b></button>
                        <button class="quick-item" data-page="Ticketing"><span class="quick-icon orange">▤</span><span><strong>Ticketing</strong><small>Support queue</small></span><b>↗</b></button>
                        <button class="quick-item" data-page="Knowledge Base"><span class="quick-icon purple">▧</span><span><strong>Knowledge Base</strong><small>Articles &amp; guides</small></span><b>↗</b></button>
                    </div>

                    <button id="quick-open-terminal" class="terminal-cta">
                        <span>›_</span>
                        <span><strong>Open terminal</strong><small>Run preview commands</small></span>
                        <b>↗</b>
                    </button>
                </section>
            </div>

            <div class="section-heading modules-heading">
                <div><h2>Management modules</h2><p>Explore the Cartman workspace.</p></div>
                <span class="section-count">13 MODULES</span>
            </div>

            <div id="category-grid" class="category-grid">
                <button class="category-card" data-page="Devices"><span class="category-icon blue">▣</span><strong>Devices</strong><p>Manage Windows, macOS and Linux endpoints.</p><span class="category-footer">Endpoint management <b>↗</b></span></button>
                <button class="category-card" data-page="Inventory"><span class="category-icon purple">▤</span><strong>Inventory</strong><p>Hardware specifications and asset details.</p><span class="category-footer">Asset information <b>↗</b></span></button>
                <button class="category-card" data-page="Software"><span class="category-icon cyan">▧</span><strong>Software</strong><p>Software inventory and deployment workflows.</p><span class="category-footer">Software management <b>↗</b></span></button>
                <button class="category-card" data-page="Remote Access"><span class="category-icon green">↗</span><strong>Remote Access</strong><p>Review authorized remote access workflows.</p><span class="category-footer">Remote operations <b>↗</b></span></button>
                <button class="category-card" data-page="Monitoring"><span class="category-icon orange">◉</span><strong>Monitoring</strong><p>Inspect resource usage and alerts.</p><span class="category-footer">Observability <b>↗</b></span></button>
                <button class="category-card" data-page="Ticketing"><span class="category-icon pink">▤</span><strong>Ticketing</strong><p>Track incidents, requests and ticket status.</p><span class="category-footer">Service operations <b>↗</b></span></button>
                <button class="category-card" data-page="Knowledge Base"><span class="category-icon cyan">▧</span><strong>Knowledge Base</strong><p>Browse troubleshooting guides and articles.</p><span class="category-footer">Documentation <b>↗</b></span></button>
                <button class="category-card" data-page="Tasks & Automation"><span class="category-icon orange">⌘</span><strong>Tasks &amp; Automation</strong><p>Review task and automation workflows.</p><span class="category-footer">Automation <b>↗</b></span></button>
                <button class="category-card" data-page="Services"><span class="category-icon blue">⚙</span><strong>Services</strong><p>Inspect operating system services.</p><span class="category-footer">Service management <b>↗</b></span></button>
                <button class="category-card" data-page="Identity & Access"><span class="category-icon purple">♙</span><strong>Identity &amp; Access</strong><p>Users, roles and access permissions.</p><span class="category-footer">IAM <b>↗</b></span></button>
                <button class="category-card" data-page="Policies"><span class="category-icon green">◈</span><strong>Policies</strong><p>Review configuration and endpoint policies.</p><span class="category-footer">Configuration <b>↗</b></span></button>
                <button class="category-card" data-page="Audit Logs"><span class="category-icon orange">≡</span><strong>Audit Logs</strong><p>Review administrative actions and events.</p><span class="category-footer">Audit &amp; compliance <b>↗</b></span></button>
                <button class="category-card" data-page="Settings"><span class="category-icon gray">⚙</span><strong>Settings</strong><p>Configure application preferences.</p><span class="category-footer">Administration <b>↗</b></span></button>
            </div>

            <div id="no-results" class="empty-state hidden">No matching modules found.</div>
        </section>

        <section id="module-view" class="hidden">
            <div class="module-header">
                <span id="module-icon" class="category-icon blue">▣</span>
                <div>
                    <div class="eyebrow">CARTMAN WORKSPACE</div>
                    <h1 id="module-title">Devices</h1>
                    <p id="module-description">Manage your infrastructure.</p>
                </div>
            </div>

            <div class="module-placeholder">
                <span class="placeholder-art">◈</span>
                <span class="preview-label">DEVELOPMENT PREVIEW</span>
                <h2 id="module-state-title">Module preview</h2>
                <p id="module-state-description">This module is part of the Cartman roadmap. Its live backend and device operations have not been implemented yet.</p>
                <div class="placeholder-actions">
                    <button id="back-home" class="primary-button">← Back to overview</button>
                    <button id="module-open-terminal" class="secondary-button">Open terminal ›_</button>
                </div>
            </div>

            <div id="module-page-content"></div>
        </section>

        <footer class="app-footer">
            <span>Cartman Infrastructure Management</span>
            <span>Development Preview · Demo data</span>
        </footer>
    </main>

    <section id="terminal-panel" class="terminal-panel" aria-hidden="true">
        <div class="terminal-header">
            <div class="terminal-heading">
                <span class="terminal-logo">›_</span>
                <div><strong>Cartman Terminal</strong><small>Local command preview</small></div>
            </div>
            <div class="terminal-controls">
                <span class="preview-badge">PREVIEW</span>
                <button id="terminal-clear" aria-label="Clear terminal" title="Clear output">⌫</button>
                <button id="terminal-close" aria-label="Close terminal" title="Close terminal">×</button>
            </div>
        </div>

        <div id="terminal-output" class="terminal-output" aria-live="polite">
            <p class="terminal-muted">Cartman Command Interface · Preview mode</p>
            <p class="terminal-muted">Type <code>help</code> to see available commands.</p>
        </div>

        <form id="terminal-form" class="terminal-input-row">
            <label for="terminal-command">cartman &gt;</label>
            <input id="terminal-command" placeholder="Enter a command..." autocomplete="off" spellcheck="false">
            <button type="submit">Run ↵</button>
        </form>

        <div class="terminal-footer">
            <span><span class="status-dot"></span> Local preview</span>
            <span>Remote execution disabled</span>
        </div>
    </section>

    <div id="toast-container" class="toast-container" aria-live="polite"></div>
</body>
</html>
