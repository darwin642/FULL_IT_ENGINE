
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1020">
    <title>Cartman | Infrastructure Management</title>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/css/modules/devices.css">
    <script src="/static/js/modules/devices.js" defer></script>
    <script src="/static/js/core/events.js" defer></script>
    <script src="/static/js/core/notifications.js" defer></script>
    <script src="/static/js/core/i18n.js" defer></script>
    <script src="/static/js/core/theme.js" defer></script>
    <script src="/static/js/core/module-definitions.js" defer></script>
    <script src="/static/app.js" defer></script>
</head>
<body>
    <header class="topbar">
        <div class="brand-area">
            <button id="menu-toggle" class="icon-button" aria-label="Toggle navigation" aria-expanded="false">☰</button>
            <a class="brand" href="#" data-page="Home">
                <span class="brand-logo">C</span>
                <span>CARTMAN</span>
            </a>
        </div>

        <div class="top-actions">
            <label class="search-box">
                <span>⌕</span>
                <input id="global-search" type="search" placeholder="Search modules..." autocomplete="off">
                <kbd>Ctrl K</kbd>
            </label>

            <div class="language-wrap">
                <button id="language-toggle" class="toolbar-button flag-toggle" aria-label="Select language" aria-expanded="false">
                    <span id="language-label"></span>
                    <span>⌄</span>
                </button>

                <div id="language-menu" class="dropdown language-menu hidden">
                    <!-- LATIN ALPHABET -->
                    <button data-language="en" title="English" aria-label="English"></button>
                    <button data-language="tr" title="Türkçe" aria-label="Turkish"></button>
                    <button data-language="de" title="Deutsch" aria-label="German"></button>
                    <button data-language="fr" title="Français" aria-label="French"></button>
                    <button data-language="es" title="Español" aria-label="Spanish"></button>
                    <button data-language="nl" title="Nederlands" aria-label="Dutch"></button>
                    <button data-language="pl" title="Polski" aria-label="Polish"></button>
                    <button data-language="it" title="Italiano" aria-label="Italian"></button>
                    <button data-language="pt-BR" title="Português" aria-label="Portuguese"></button>
                    <button data-language="bcs" title="Bosanski / Hrvatski / Srpski" aria-label="Bosnian Croatian Serbian"></button>
                    <button data-language="sq" title="Shqip" aria-label="Albanian"></button>
                    <button data-language="cs" title="Čeština" aria-label="Czech"></button>
                    <button data-language="lt" title="Lietuvių" aria-label="Lithuanian"></button>
                    <button data-language="sv" title="Svenska" aria-label="Swedish"></button>
                    <button data-language="no" title="Norsk bokmål" aria-label="Norwegian"></button>
                    <button data-language="da" title="Dansk" aria-label="Danish"></button>
                    <button data-language="fi" title="Suomi" aria-label="Finnish"></button>
                    <button data-language="az" title="Azərbaycanca" aria-label="Azerbaijani"></button>
                    <button data-language="id" title="Bahasa Indonesia" aria-label="Indonesian"></button>
                    <button data-language="ms" title="Bahasa Melayu" aria-label="Malay"></button>
                    <button data-language="et" title="Eesti" aria-label="Estonian"></button>
                    <button data-language="hu" title="Magyar" aria-label="Hungarian"></button>

                    <!-- OTHER ALPHABETS -->
                    <button data-language="ja" title="日本語" aria-label="Japanese"></button>
                    <button data-language="ar" title="العربية" aria-label="Arabic"></button>
                    <button data-language="zh-CN" title="简体中文" aria-label="Simplified Chinese"></button>
                    <button data-language="ru" title="Русский" aria-label="Russian"></button>
                    <button data-language="el" title="Ελληνικά" aria-label="Greek"></button>
                    <button data-language="he" title="עברית" aria-label="Hebrew"></button>
                    <button data-language="ko" title="한국어" aria-label="Korean"></button>
                </div>
            </div>

            <button id="terminal-toggle" class="toolbar-button terminal-button">
                <span>›_</span><span>Terminal</span>
            </button>

            <button id="theme-toggle" class="toolbar-button" aria-label="Switch theme">
                ☀ <span id="theme-label">Light mode</span>
            </button>

            <div class="profile-wrap">
                <button id="profile-toggle" class="profile-button" aria-expanded="false">
                    <span class="avatar">K</span>
                    <span class="profile-info">
                        <strong>Kaan Yaşar</strong>
                        <small>Administrator · Demo</small>
                    </span>
                    <span>⌄</span>
                </button>

                <div id="profile-menu" class="dropdown profile-menu hidden">
                    <div class="dropdown-heading">Current session</div>
                    <strong>Kaan Yaşar</strong>
                    <small>Administrator · Demo UI</small>
                    <button data-page="Settings">Account settings</button>
                </div>
            </div>
        </div>
    </header>

    <div id="page-backdrop" class="page-backdrop"></div>

    <aside id="sidebar" class="sidebar">
        <div class="sidebar-brand">
            <span class="sidebar-brand-dot"></span>
